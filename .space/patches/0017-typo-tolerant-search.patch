index b7f79ac1de54788b30f90710bc8ff1e4253b0d5f..6aa60c0d3234ac430f042f9c80a37eca93569fed 100644
--- a/Tinycast/Features/Launcher/Model/LauncherMatch.swift
+++ b/Tinycast/Features/Launcher/Model/LauncherMatch.swift
@@ -170,6 +170,72 @@ enum LauncherMatch {
     private static func wordPoints(_ t: [UInt16], _ column: Int, humps: [Int]) -> Int {
         (isSeparator(t[column - 1]) && !isSeparator(t[column])) || humps.contains(column) ? 3 : 2
