{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Tinycast (debug)",
      "type": "shell",
      "command": "make",
      "args": ["-C", "${workspaceFolder}", "build-debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Prepare Tinycast source",
      "type": "shell",
      "command": "make",
      "args": ["-C", "${workspaceFolder}", "prepare"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Test Tinycast",
      "type": "shell",
      "command": "make",
      "args": ["-C", "${workspaceFolder}", "test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Lint Tinycast",
      "type": "shell",
      "command": "make",
      "args": ["-C", "${workspaceFolder}", "lint"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
