From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Abue Ammar <14371506+abue-ammar@users.noreply.github.com>
Date: Sun, 18 Oct 2026 12:59:51 +0600
Subject: [PATCH] Lock app bundles the user can't write before uninstalling
 (#1635)

App Store and TestFlight bundles are root:wheel drwxr-xr-x inside an
admin-writable /Applications. The classifier only checked the parent's
write bit, so the bundle row was checkable, and the trash failed with
EPERM: moving a directory to a new parent rewrites its `..` entry, which
needs write permission on the directory itself (#1634).

The scanner now records whether a candidate is a directory and whether
the user can write it. A directory they can't write classifies as
.notWritable, so the row is locked and says to drag it to the Trash in
Finder. The leftovers still trash, and the app's references stay because
the bundle did not go.
---
 Tests/uninstall-test.swift                    | 14 ++++-
 .../Uninstall/Model/UninstallProtection.swift | 14 ++++-
 .../Uninstall/Service/UninstallScanner.swift  | 10 ++--
 Tinycast/Resources/Localizable.xcstrings      | 52 +++++++++++++++++++
 docs/features/uninstall.md                    | 11 +++-
 5 files changed, 92 insertions(+), 9 deletions(-)

diff --git a/Tests/uninstall-test.swift b/Tests/uninstall-test.swift
index 768004fa..c50c9e90 100644
--- a/Tests/uninstall-test.swift
+++ b/Tests/uninstall-test.swift
@@ -437,6 +437,16 @@ struct UninstallTests {
             classify(PathFacts(path: "/Library/Caches/com.foo.Bar", parentIsWritable: false))
                 == .parentNotWritable,
             "trashing is a rename out of the parent, so an unwritable parent locks the row")
+        expect(
+            classify(
+                PathFacts(
+                    path: "/Applications/Store App.app", isDirectory: true, isWritable: false,
+                    isOwnedByCurrentUser: false)) == .notWritable,
+            "a root-owned App Store bundle is locked — moving a directory rewrites its own `..`")
+        expect(
+            classify(PathFacts(path: "/Library/Caches/com.foo.Bar.plist", isWritable: false))
+                == .removable,
+            "an unwritable file still trashes — only a directory needs its own write bit")
 
         let container = PathFacts(path: home + "/Library/Containers/com.foo.Bar")
         expect(
@@ -448,8 +458,8 @@ struct UninstallTests {
 
         let everything = PathFacts(
             path: home + "/Library/Containers/com.foo.Bar", volumeIsReadOnly: true,
-            isSystemRestricted: true, isUserImmutable: true, isOwnedByCurrentUser: false,
-            parentIsWritable: false, parentIsSticky: true)
+            isSystemRestricted: true, isUserImmutable: true, isDirectory: true, isWritable: false,
+            isOwnedByCurrentUser: false, parentIsWritable: false, parentIsSticky: true)
         expect(
             classify(everything) == .systemProtected,
             "precedence: a SIP path reports as system-protected, the most useful of its reasons")
diff --git a/Tinycast/Features/Uninstall/Model/UninstallProtection.swift b/Tinycast/Features/Uninstall/Model/UninstallProtection.swift
index f8a61880..3162b68e 100644
--- a/Tinycast/Features/Uninstall/Model/UninstallProtection.swift
+++ b/Tinycast/Features/Uninstall/Model/UninstallProtection.swift
@@ -11,6 +11,9 @@ struct PathFacts: Hashable, Sendable {
     var isSystemRestricted = false
     /// `UF_IMMUTABLE` — Finder's "Locked" checkbox, which the user can clear themselves.
     var isUserImmutable = false
+    var isDirectory = false
+    /// Only decides anything for a directory — see `classify`.
+    var isWritable = true
     /// Only decides anything under a sticky parent — see `classify`.
     var isOwnedByCurrentUser = true
     var parentIsWritable = true
@@ -32,6 +35,7 @@ enum UninstallProtection: String, Hashable, Sendable, CaseIterable {
     case notOwned
     case needsFullDiskAccess
     case parentNotWritable
+    case notWritable
     case missing
 
     var isRemovable: Bool { self == .removable }
@@ -60,6 +64,12 @@ enum UninstallProtection: String, Hashable, Sendable, CaseIterable {
                     Its enclosing folder isn’t writable by you, and Tinycast never asks for an \
                     administrator password.
                     """)
+        case .notWritable:
+            return String(
+                localized: """
+                    Only an administrator can move it, as with App Store apps. \
+                    Drag it to the Trash in Finder instead.
+                    """)
         case .missing:
             return String(localized: "No longer on disk.")
         }
@@ -77,10 +87,12 @@ enum UninstallProtectionRules {
         {
             return .needsFullDiskAccess
         }
-        // Trashing renames out of the parent, so its write bit decides, not the item's owner.
+        // Trashing renames out of the parent, so its write bit counts, not the item's owner.
         if !facts.parentIsWritable { return .parentNotWritable }
         // The one case where ownership does decide: a sticky parent lets only an owner unlink.
         if facts.parentIsSticky, !facts.isOwnedByCurrentUser { return .notOwned }
+        // Moving a directory to a new parent rewrites its `..`, so its own write bit counts too.
+        if facts.isDirectory, !facts.isWritable { return .notWritable }
         return .removable
     }
 
diff --git a/Tinycast/Features/Uninstall/Service/UninstallScanner.swift b/Tinycast/Features/Uninstall/Service/UninstallScanner.swift
index 14588d90..fecc1bec 100644
--- a/Tinycast/Features/Uninstall/Service/UninstallScanner.swift
+++ b/Tinycast/Features/Uninstall/Service/UninstallScanner.swift
@@ -163,14 +163,14 @@ enum UninstallScanner {
         let protection = UninstallProtectionRules.classify(scanned.facts, environment: environment)
         guard protection != .missing else { return nil }
         // A symlink is trashed as the link, so it never costs more than its own bytes.
-        let walkable = scanned.isDirectory && !scanned.facts.isSymbolicLink
+        let walkable = scanned.facts.isDirectory && !scanned.facts.isSymbolicLink
         return UninstallCandidate(
             path: path,
             name: displayName ?? (path as NSString).lastPathComponent,
             locationLabel: UninstallRules.abbreviate(
                 (path as NSString).deletingLastPathComponent, home: environment.home),
             evidence: evidence,
-            isDirectory: scanned.isDirectory,
+            isDirectory: scanned.facts.isDirectory,
             size: walkable ? nil : MeasuredSize(bytes: scanned.byteSize),
             protection: protection)
     }
@@ -179,7 +179,7 @@ enum UninstallScanner {
     private static func inspect(
         _ path: String, parent: ParentFacts?
     )
-        -> (facts: PathFacts, isDirectory: Bool, byteSize: Int64)?
+        -> (facts: PathFacts, byteSize: Int64)?
     {
         var info = stat()
         guard lstat(path, &info) == 0 else { return nil }
@@ -193,11 +193,13 @@ enum UninstallScanner {
             volumeIsReadOnly: volumeIsReadOnly,
             isSystemRestricted: info.st_flags & UInt32(SF_RESTRICTED | SF_IMMUTABLE) != 0,
             isUserImmutable: info.st_flags & UInt32(UF_IMMUTABLE) != 0,
+            isDirectory: (info.st_mode & S_IFMT) == S_IFDIR,
+            isWritable: FileManager.default.isWritableFile(atPath: path),
             isOwnedByCurrentUser: info.st_uid == geteuid(),
             parentIsWritable: parent.isWritable,
             parentIsSticky: parent.isSticky)
         // `st_size`, not `st_blocks`: a 593-byte plist occupies a block and must not read as 4 kB.
-        return (facts, (info.st_mode & S_IFMT) == S_IFDIR, Int64(info.st_size))
+        return (facts, Int64(info.st_size))
     }
 
     /// The permission that actually governs a trash, resolved once per root.
