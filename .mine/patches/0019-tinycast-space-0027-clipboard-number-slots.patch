From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tinycast Recipe <recipe@localhost>
Date: Sat, 24 Oct 2026 12:45:37 -0300
Subject: [PATCH] tinycast-space 0027: clipboard number slots
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Clipboard History: ⌘1–⌘9 open the Nth visible row as Return would. Pins lead the list and keep their slots (⌘0 still opens a tenth pin); unpinned rows carry the count on, with digits after upstream's 400 ms hold. After [mSarheed/pipcast](https://github.com/mSarheed/pipcast/commit/96377314), without its instant reveal.

Origin: tinycast-space 0027-clipboard-number-slots.patch @ ffccfc3
---
 Tests/clipboard-test.swift                    | 19 +++++++++++++++++++
 .../Clipboard/Model/ClipboardStore.swift      | 17 +++++++++++++++++
 .../Clipboard/UI/ClipboardScreen.swift        |  2 +-
 .../Features/Clipboard/UI/ClipboardView.swift |  9 +++++----
 4 files changed, 42 insertions(+), 5 deletions(-)

diff --git a/Tests/clipboard-test.swift b/Tests/clipboard-test.swift
index 0cff0278..138f304e 100644
--- a/Tests/clipboard-test.swift
+++ b/Tests/clipboard-test.swift
@@ -283,6 +283,25 @@ struct ClipboardTests {
             expect(
                 store.pinnedItem(at: 0, in: "", filter: .link) == nil,
                 "filter applies before pinned slot mapping")
+
+            expect(
+                (0..<3).allSatisfy {
+                    store.numberedItem(at: $0, in: "", filter: .all)?.id
+                        == store.pinnedItem(at: $0, in: "", filter: .all)?.id
+                },
+                "pinned slots keep their meaning")
+            expect(
+                store.numberedItem(at: 3, in: "", filter: .all)?.text == "plain text",
+                "the first unpinned row carries the numbering on after the pins")
+            expect(
+                store.numberedItem(at: 4, in: "", filter: .all) == nil, "no row, no slot")
+            expect(
+                store.numberedItem(at: 0, in: "plain", filter: .all)?.text == "plain text",
+                "a query numbers the rows it shows")
+            expect(
+                !ClipboardStore.isNumbered(row: 9, pinned: false)
+                    && ClipboardStore.isNumbered(row: 9, pinned: true),
+                "unpinned rows stop at nine; a tenth pin keeps its ⌘0")
         }
     }
 
diff --git a/Tinycast/Features/Clipboard/Model/ClipboardStore.swift b/Tinycast/Features/Clipboard/Model/ClipboardStore.swift
index 501b5f4f..50c1778f 100644
--- a/Tinycast/Features/Clipboard/Model/ClipboardStore.swift
+++ b/Tinycast/Features/Clipboard/Model/ClipboardStore.swift
@@ -600,6 +600,23 @@ final class ClipboardStore {
         return search(query, filter: filter).prefix(while: \.isPinned).dropFirst(index).first
     }
 
+    /// tinycast-space: ⌘1–⌘9 reach this many rows whether pinned or not; ⌘0 stays for a tenth pin.
+    static let numberedRowLimit = 9
+
+    /// Whether the visible row at `index` answers a ⌘-digit. The Pinned section always leads the
+    /// list, so a pinned slot is its row's index and the rows after it carry on the count.
+    static func isNumbered(row index: Int, pinned: Bool) -> Bool {
+        index >= 0 && (pinned || index < numberedRowLimit)
+    }
+
+    /// The row ⌘ plus slot `index` opens: pinned slots as `pinnedItem`, then unpinned rows in order.
+    func numberedItem(at index: Int, in query: String, filter: ClipboardFilter) -> ClipboardItem? {
+        let rows = search(query, filter: filter)
+        guard rows.indices.contains(index), Self.isNumbered(row: index, pinned: rows[index].isPinned)
+        else { return nil }
+        return rows[index]
+    }
+
     /// Where a reset lands: past the pins to the newest clip, or on the first match once typed.
     func landingIndex(in query: String, filter: ClipboardFilter) -> Int {
         guard query.trimmingCharacters(in: .whitespaces).isEmpty else { return 0 }
diff --git a/Tinycast/Features/Clipboard/UI/ClipboardScreen.swift b/Tinycast/Features/Clipboard/UI/ClipboardScreen.swift
index b03c2d67..7cdca906 100644
--- a/Tinycast/Features/Clipboard/UI/ClipboardScreen.swift
+++ b/Tinycast/Features/Clipboard/UI/ClipboardScreen.swift
@@ -70,7 +70,7 @@ struct ClipboardScreen: PaletteScreen {
     }
 
     private func activatePinned(at index: Int) -> Bool {
-        guard let item = store.pinnedItem(at: index, in: vm.query, filter: vm.clipboardFilter) else {
+        guard let item = store.numberedItem(at: index, in: vm.query, filter: vm.clipboardFilter) else {
             return false
         }
         core.clipboardCoordinator.activate(item)
diff --git a/Tinycast/Features/Clipboard/UI/ClipboardView.swift b/Tinycast/Features/Clipboard/UI/ClipboardView.swift
index a6f9ec51..9542493f 100644
--- a/Tinycast/Features/Clipboard/UI/ClipboardView.swift
+++ b/Tinycast/Features/Clipboard/UI/ClipboardView.swift
@@ -36,15 +36,16 @@ struct ClipboardList: View {
     private var rows: [Row] {
         var rows: [Row] = []
         var currentTitle: String?
-        var pinnedSlot = 0
-        for item in results {
+        for (index, item) in results.enumerated() {
             let title = item.isPinned ? String(localized: "Pinned") : DateBucket(for: item.createdAt).title
             if title != currentTitle {
                 rows.append(.header(title))
                 currentTitle = title
             }
-            let slot = item.isPinned ? FavoriteSlots.digit(at: pinnedSlot) : nil
-            if item.isPinned { pinnedSlot += 1 }
+            // tinycast-space: the pins lead, so the unpinned rows below carry the numbering on.
+            let slot =
+                ClipboardStore.isNumbered(row: index, pinned: item.isPinned)
+                ? FavoriteSlots.digit(at: index) : nil
             rows.append(.item(item, slot: slot))
         }
         return rows
