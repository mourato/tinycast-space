@@ -16,6 +16,7 @@ final class CurrencyRateStore {
     private static let retryInterval: TimeInterval = 30 * 60
 
     private(set) var rates: CurrencyRates?
+    private(set) var isRefreshing = false
 
     private let fileURL: URL
     @ObservationIgnored private var pump: Task<Void, Never>?
@@ -49,6 +50,17 @@ final class CurrencyRateStore {
         }
     }
 
+    /// The pump re-measures age from `completedAt` when it wakes, so its schedule needs no reset.
+    func refresh() {
+        guard !isRefreshing else { return }
+        isRefreshing = true
+        Task {
+            await fetchAndStore()
+            isRefreshing = false
+        }
+    }
+
+    @discardableResult
     private func fetchAndStore() async -> Bool {
         guard let result = await Self.fetch() else { return false }
         rates = result.rates
diff --git a/Tinycast/Features/Calculator/UI/CalculatorCardView.swift b/Tinycast/Features/Calculator/UI/CalculatorCardView.swift
index 3ae8df43..7b6f6397 100644
--- a/Tinycast/Features/Calculator/UI/CalculatorCardView.swift
+++ b/Tinycast/Features/Calculator/UI/CalculatorCardView.swift
@@ -70,10 +70,49 @@ struct CalculatorCard: View {
         }
         .padding(.horizontal, metrics.spacing.xl)
         .padding(.vertical, metrics.spacing.xxxl)
+        .overlay(alignment: .bottomTrailing) {
+            if result.isCurrency { RatesFreshness() }
+        }
         .leadCard(selected: selected)
     }
 }
 
+private struct RatesFreshness: View {
+    @Environment(\.metrics) private var metrics
+    @Environment(CurrencyRateStore.self) private var currencyRates
+    @State private var hovered = false
+
+    var body: some View {
+        if let fetchedAt = currencyRates.rates?.fetchedAt {
+            HStack(spacing: metrics.spacing.xs) {
+                Text("Updated \(fetchedAt, formatter: Self.formatter)")
+                Button(
+                    "Refresh Exchange Rates", systemImage: "arrow.clockwise", action: currencyRates.refresh
+                )
+                .labelStyle(.iconOnly)
+                .buttonStyle(.plain)
+                .symbolEffect(.rotate, options: .repeat(.continuous), isActive: currencyRates.isRefreshing)
+                .foregroundStyle(hovered ? .secondary : .tertiary)
+                .onHover { hovered = $0 }
+                .help("Refresh Exchange Rates")
+            }
+            .font(metrics.typography.compactKeyCap)
+            .foregroundStyle(.tertiary)
+            .padding(.trailing, metrics.spacing.lg)
+            .padding(.bottom, metrics.spacing.md)
+        }
+    }
+
+    @MainActor private static let formatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.dateStyle = .medium
+        formatter.timeStyle = .short
+        formatter.doesRelativeDateFormatting = true
+        formatter.formattingContext = .middleOfSentence
+        return formatter
+    }()
+}
+
