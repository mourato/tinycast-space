From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Renato <remourato@gmail.com>
Date: Mon, 12 Oct 2026 00:19:42 -0300
Subject: [PATCH] Show image files under Images Only in clipboard history

A PNG copied in Finder is recorded as a file reference, so Images Only
missed it while Files Only listed it. The type filter, the OCR search and
Copy Text now share one image-file check. The OCR search runs that check
in SQL, so its result limit counts only the filter's own rows.

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
---
 Tests/clipboard-search-test.swift             |  3 ++-
 Tests/clipboard-test.swift                    |  9 ++++++++
 .../Clipboard/Model/ClipboardFilter.swift     |  4 ++--
 .../Clipboard/Model/ClipboardStore.swift      | 21 +++++++++++++++++--
 docs/features/clipboard.md                    |  4 +++-
 5 files changed, 35 insertions(+), 6 deletions(-)

diff --git a/Tests/clipboard-search-test.swift b/Tests/clipboard-search-test.swift
index f356c51f..fedb8ddb 100644
--- a/Tests/clipboard-search-test.swift
+++ b/Tests/clipboard-search-test.swift
@@ -23,7 +23,8 @@ struct ClipboardSearchTests {
             let item = ClipboardItem(
                 id: UUID(), kind: kind,
                 text: kind == .text
-                    ? "Common alphabet" + suffix : kind == .file ? "/fixture/common\(index).pdf" : nil,
+                    ? "Common alphabet" + suffix
+                    : kind == .file ? "/fixture/common\(index)" + (index % 2 == 0 ? ".pdf" : ".png") : nil,
                 imagePath: kind == .image ? "/fixture/\(index).png" : nil,
                 createdAt: now.addingTimeInterval(Double(-index)), sourceBundleID: nil,
                 pinnedAt: index < 220 ? now.addingTimeInterval(Double(-index)) : nil)
diff --git a/Tests/clipboard-test.swift b/Tests/clipboard-test.swift
index af2e762a..16775d67 100644
--- a/Tests/clipboard-test.swift
+++ b/Tests/clipboard-test.swift
@@ -494,6 +494,15 @@ struct ClipboardTests {
             expect(
                 texts(store, filter: .link) == ["https://apple.com", "second.link.dev"],
                 "a pinned link leads its filtered block")
+
+            store.addFiles(
+                ["/Users/me/Desktop/Shot.png", "/Users/me/Desktop/Report.pdf"], sourceBundleID: nil)
+            expect(
+                texts(store, filter: .image) == ["/Users/me/Desktop/Shot.png"],
+                "an image copied in Finder is an image")
+            expect(
+                texts(store, filter: .file) == ["/Users/me/Desktop/Report.pdf"],
+                "so Files Only leaves it out, and keeps a PDF")
         }
     }
 
diff --git a/Tinycast/Features/Clipboard/Model/ClipboardFilter.swift b/Tinycast/Features/Clipboard/Model/ClipboardFilter.swift
index 1561bcdb..2492c139 100644
--- a/Tinycast/Features/Clipboard/Model/ClipboardFilter.swift
+++ b/Tinycast/Features/Clipboard/Model/ClipboardFilter.swift
@@ -51,8 +51,8 @@ enum ClipboardFilter: CaseIterable, Sendable {
     func matches(_ item: ClipboardItem) -> Bool {
         switch self {
         case .all: return true
-        case .image: return item.kind == .image
-        case .file: return item.kind == .file
+        case .image: return item.kind == .image || item.isImageFile
+        case .file: return item.kind == .file && !item.isImageFile
         case .text: return item.textForm == .plain
         case .color: return item.textForm == .color
         case .link: return item.textForm == .link
diff --git a/Tinycast/Features/Clipboard/Model/ClipboardStore.swift b/Tinycast/Features/Clipboard/Model/ClipboardStore.swift
index ce0f4b7a..99872d00 100644
--- a/Tinycast/Features/Clipboard/Model/ClipboardStore.swift
+++ b/Tinycast/Features/Clipboard/Model/ClipboardStore.swift
@@ -24,6 +24,9 @@ struct ClipboardItem: Identifiable, Hashable, Sendable {
     /// The referenced path, so no call site re-derives a file entry's meaning from `text`.
     var filePath: String? { kind == .file ? text : nil }
 
+    /// A referenced file the type filter files under images, by its extension rather than its kind.
+    var isImageFile: Bool { filePath.map { ClipboardFileKind.of(path: $0) == .image } ?? false }
+
     /// What Paste as Plain Text writes: the text, or a file's path in place of the file.
     var plainText: String? { kind == .image ? nil : text }
 
@@ -31,7 +34,7 @@ struct ClipboardItem: Identifiable, Hashable, Sendable {
     var offersTextExtraction: Bool {
         switch kind {
         case .image: return imagePath != nil
-        case .file: return filePath.map { ClipboardFileKind.of(path: $0) == .image } ?? false
+        case .file: return isImageFile
         case .text: return false
         }
     }
@@ -671,8 +674,22 @@ final class ClipboardStore {
         defer { sqlite3_close_v2(db) }
         sqlite3_exec(db, "PRAGMA cache_size=-2048", nil, nil, nil)
         sqlite3_progress_handler(db, 1000, { _ in Task.isCancelled ? 1 : 0 }, nil)
+        // Shares `isImageFile`'s classifier, so the LIMIT below counts only the filter's rows.
+        sqlite3_create_function_v2(
+            db, "is_image_file", 1, SQLITE_UTF8 | SQLITE_DETERMINISTIC, nil,
+            { context, _, values in
+                guard let values, let text = sqlite3_value_text(values[0]) else {
+                    sqlite3_result_int(context, 0)
+                    return
+                }
+                let count = Int(sqlite3_value_bytes(values[0]))
+                let path = String(decoding: UnsafeBufferPointer(start: text, count: count), as: UTF8.self)
+                sqlite3_result_int(context, ClipboardFileKind.of(path: path) == .image ? 1 : 0)
+            }, nil, nil, nil)
         let isShort = query.count < 3
-        let kind = filter == .image ? "i.kind = 'image'" : filter == .file ? "i.kind = 'file'" : "1"
+        let kind =
+            filter == .image ? "(i.kind = 'image' OR (i.kind = 'file' AND is_image_file(i.text)))"
+            : filter == .file ? "(i.kind = 'file' AND NOT is_image_file(i.text))" : "1"
         let columns = "i.id, i.kind, i.text, i.image_path, i.created_at, i.source_app, i.pinned_at"
         let sql =
             isShort
diff --git a/docs/features/clipboard.md b/docs/features/clipboard.md
index e381809a..e646158b 100644
--- a/docs/features/clipboard.md
+++ b/docs/features/clipboard.md
@@ -250,7 +250,9 @@ the way back out.
 `ClipboardFilter` owns the seven cases and everything the UI needs from them — title, glyph, and the
 `emptyMessage` that stops "Clipboard history is empty" from appearing over a history that only looks
 empty. The cases are **exclusive**: a copied URL is a link, not a narrower kind of text, so *Text
-Only* means prose, and *Colors Only* takes `#FF5733` out of it.
+Only* means prose, and *Colors Only* takes `#FF5733` out of it. An image file copied in Finder is
+an image: *Images Only* takes it by extension, and *Files Only* leaves it out. The OCR search
+applies the same rule in SQL, through the `is_image_file` function that `isImageFile` shares.
 
 `ClipboardItem.textForm` derives `plain`/`color`/`link`/`email` from the text on demand — nil for an
 image.
