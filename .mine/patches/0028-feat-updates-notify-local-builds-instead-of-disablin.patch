From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Renato <remourato@gmail.com>
Date: Wed, 14 Oct 2026 19:13:35 -0300
Subject: [PATCH] feat(updates): notify local builds instead of disabling the
 updater

Local builds now check the release feed and show the changelog, but never
install: releases are signed by another identity, so BundleSignature would
refuse them. The window offers View Release instead of Update Now.

.mine/build.sh versions the build from the base's release tag, so only
newer releases are offered.

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
---
 Tinycast/Features/Updates/Model/ReleaseFeed.swift  |  5 +++++
 .../Features/Updates/UI/UpdateCoordinator.swift    | 12 +++++++++++-
 .../Features/Updates/UI/UpdateWindowView.swift     | 14 +++++++++++---
 docs/features/updates.md                           |  5 +++++
 4 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/Tinycast/Features/Updates/Model/ReleaseFeed.swift b/Tinycast/Features/Updates/Model/ReleaseFeed.swift
index a68d9e5a..5d28d042 100644
--- a/Tinycast/Features/Updates/Model/ReleaseFeed.swift
+++ b/Tinycast/Features/Updates/Model/ReleaseFeed.swift
@@ -29,6 +29,11 @@ enum ReleaseFeed {
             .max { $0.version < $1.version }
     }
 
+    /// The release's page on GitHub, where a build that cannot install it sends the user.
+    static func page(for release: AvailableRelease) -> URL {
+        URL(string: "https://github.com/\(repository)/releases/tag/\(release.tag)")!
+    }
+
     /// The release worth offering: strictly newer than what runs, and not skipped.
     static func offer(
         _ release: AvailableRelease?, running: AppVersion, skipped: AppVersion?
diff --git a/Tinycast/Features/Updates/UI/UpdateCoordinator.swift b/Tinycast/Features/Updates/UI/UpdateCoordinator.swift
index 7ead406f..48df8b94 100644
--- a/Tinycast/Features/Updates/UI/UpdateCoordinator.swift
+++ b/Tinycast/Features/Updates/UI/UpdateCoordinator.swift
@@ -5,6 +5,9 @@ import SwiftUI
 @MainActor
 @Observable
 final class UpdateCoordinator {
+    /// Releases are signed by another identity than local builds, so BundleSignature refuses them.
+    static let installsUpdates = false
+
     /// One surface for prompt, progress and report: a download cannot move into a dialog.
     enum Stage: Equatable {
         case checking
@@ -110,7 +113,7 @@ final class UpdateCoordinator {
     // MARK: - Actions
 
     func install() {
-        guard let release = pendingRelease else { return }
+        guard Self.installsUpdates, let release = pendingRelease else { return }
         // Re-asked at the moment of the click, never read from a flag that could have gone stale.
         if let blocker = UpdateReadiness.evaluate(core.currentActivity) {
             stage = .blocked(blocker, release)
@@ -137,6 +140,13 @@ final class UpdateCoordinator {
         }
     }
 
+    /// What a build that cannot install offers instead: the release page, where its notes live.
+    func openReleasePage() {
+        guard let release = pendingRelease else { return }
+        NSWorkspace.shared.open(ReleaseFeed.page(for: release))
+        window.close()
+    }
+
     /// Dismissing a version is what stops it asking again; a later one still will.
     func skip() {
         if let release = pendingRelease { store.skip(release) }
diff --git a/Tinycast/Features/Updates/UI/UpdateWindowView.swift b/Tinycast/Features/Updates/UI/UpdateWindowView.swift
index 035738a4..30e37634 100644
--- a/Tinycast/Features/Updates/UI/UpdateWindowView.swift
+++ b/Tinycast/Features/Updates/UI/UpdateWindowView.swift
@@ -86,7 +86,10 @@ struct UpdateWindowView: View {
         case .localBuild:
             return String(localized: "This is a local build — rebuild it to move it forward.")
         case .available, .blocked, .installing:
-            return String(localized: "You have \(updates.runningVersion).")
+            guard UpdateCoordinator.installsUpdates else {
+                return "You have \(updates.runningVersion). Local builds don't install updates."
+            }
+            return "You have \(updates.runningVersion)."
         case .readyToRelaunch:
             return String(localized: "Relaunch to start using it.")
         }
@@ -171,8 +174,13 @@ struct UpdateWindowView: View {
             case .available:
                 Button("Later") { updates.skip() }
                     .keyboardShortcut(.cancelAction)
-                Button("Update Now") { updates.install() }
-                    .keyboardShortcut(.defaultAction)
+                if UpdateCoordinator.installsUpdates {
+                    Button("Update Now") { updates.install() }
+                        .keyboardShortcut(.defaultAction)
+                } else {
+                    Button("View Release") { updates.openReleasePage() }
+                        .keyboardShortcut(.defaultAction)
+                }
             case .blocked:
                 Button("Later") { updates.skip() }
                     .keyboardShortcut(.cancelAction)
diff --git a/docs/features/updates.md b/docs/features/updates.md
index 146ca469..c6577426 100644
--- a/docs/features/updates.md
+++ b/docs/features/updates.md
@@ -68,6 +68,11 @@ no appcast: the release feed the website already reads is the feed the app reads
   the web, and a bare mention is what notifies the contributor, so the published body keeps them
   plain and `ReleaseNotes` spells them as Markdown links on the way to the window. Both point at
   `ReleaseFeed.repository`, the one place the repo is named.
+- **A build that cannot install still notifies.** `UpdateCoordinator.installsUpdates` is `false` in
+  this fork: releases are signed by another identity than local builds, so `BundleSignature` refuses
+  them. The window shows the changelog and offers *View Release*, which opens the GitHub page. Local
+  builds run as the base's release tag (`.mine/build.sh` sets `MARKETING_VERSION`), so only newer
+  releases are offered.
 
 ## Channel and version
 
