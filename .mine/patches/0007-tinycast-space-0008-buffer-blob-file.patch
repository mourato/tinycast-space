From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tinycast Recipe <recipe@localhost>
Date: Sat, 24 Oct 2026 12:45:26 -0300
Subject: [PATCH] tinycast-space 0008: buffer blob file

Extension runtime: `require("buffer")` exposes `Blob` and `File`, as Node's does. Undici subclasses them, so extensions bundling it (Google Translate) crashed on load with "The superclass is not a constructor".

Origin: tinycast-space 0008-buffer-blob-file.patch @ ffccfc3
---
 Scripts/raycast-runtime/src/buffer.js          | 5 +++++
 Tinycast/Resources/RaycastRuntime.generated.js | 2 +-
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/Scripts/raycast-runtime/src/buffer.js b/Scripts/raycast-runtime/src/buffer.js
index 983ea5ea..29d9791f 100644
--- a/Scripts/raycast-runtime/src/buffer.js
+++ b/Scripts/raycast-runtime/src/buffer.js
@@ -612,4 +612,9 @@ export const bufferModule = {
   kMaxLength: 0x7fffffff,
   isEncoding: (encoding) => Buffer.isEncoding(encoding),
   isBuffer: (value) => Buffer.isBuffer(value),
+  // tinycast-space: Node's buffer module re-exports the Web Blob and File; undici subclasses
+  // them (`class File extends require("buffer").Blob`), so without these it cannot even load.
+  // Getters, because polyfills.js installs the globals after this module is evaluated.
+  get Blob() { return globalThis.Blob; },
+  get File() { return globalThis.File; },
 };
