++                .frame(width: 20, height: 20)
++            Text(title).foregroundStyle(colors.ink(1))
++            Spacer()
++            Text(kind).foregroundStyle(colors.ink(colors.isDark ? 0.40 : 0.42))
++        }
++        .font(.system(size: 13))
