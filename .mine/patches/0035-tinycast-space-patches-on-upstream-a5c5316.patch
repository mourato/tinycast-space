++        }
++        .frame(width: metrics.scaled(112), height: metrics.scaled(20))
++        .background(
++            RoundedRectangle(cornerRadius: metrics.radius.menuRow, style: .continuous)
++                .fill(Theme.Colors.cardFill))
++        .overlay(
++            RoundedRectangle(cornerRadius: metrics.radius.menuRow, style: .continuous)
++                .strokeBorder(
