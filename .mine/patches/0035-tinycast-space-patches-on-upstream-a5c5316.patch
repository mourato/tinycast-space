++            let printable = (event.characters ?? "").unicodeScalars.filter {
++                $0.value >= 0x20 && $0.value != 0x7F && !(0xF700...0xF8FF).contains($0.value)
++            }
++            if !printable.isEmpty { aliasDraft += String(String.UnicodeScalarView(printable)) }
++        }
++        return true
++    }
++}
++
