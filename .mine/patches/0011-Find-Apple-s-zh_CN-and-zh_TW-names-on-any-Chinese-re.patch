From: Abue Ammar <14371506+abue-ammar@users.noreply.github.com>
Date: Mon, 19 Oct 2026 07:10:49 +0600
Subject: [PATCH] Find Apple's zh_CN and zh_TW names on any Chinese region
 (#1645)

---
 Tests/app-name-test.swift                  | 24 ++++++++++++++++++++--
 Tinycast/Platform/BundleLocalization.swift | 17 +++++++++------
 docs/features/launcher.md                  | 14 +++++++------
 3 files changed, 41 insertions(+), 14 deletions(-)

diff --git a/Tests/app-name-test.swift b/Tests/app-name-test.swift
index 64a68576..eaccafb8 100644
--- a/Tests/app-name-test.swift
+++ b/Tests/app-name-test.swift
@@ -99,9 +99,23 @@ struct AppNameTest {
             "a Simplified Chinese Mac looks up the zh_CN Apple actually keys by",
             codes(["zh-Hans-CN"]).contains("zh_CN"))
         check(
-            "a script-bearing tag also reads the zh-Hans folder most apps ship, before its region",
+            "a script-bearing tag reads the zh-Hans folder, its own region, then the script's zh_CN",
             codes(["zh-Hans-US"])
-                == ["zh-Hans-US", "zh_Hans_US", "zh-Hans", "zh_Hans", "zh-US", "zh_US", "zh", "en"])
+                == [
+                    "zh-Hans-US", "zh_Hans_US", "zh-Hans", "zh_Hans", "zh-US", "zh_US", "zh-CN",
+                    "zh_CN", "zh", "en"
+                ])
+        check(
+            "Hong Kong Traditional Chinese reads zh_HK, then Taiwan's zh_TW, never zh_CN",
+            codes(["zh-Hant-HK"])
+                == [
+                    "zh-Hant-HK", "zh_Hant_HK", "zh-Hant", "zh_Hant", "zh-HK", "zh_HK", "zh-TW",
+                    "zh_TW", "zh", "en"
+                ])
+        check(
+            "a region written in the other script is skipped",
+            !codes(["zh-Hans-HK"]).contains("zh_HK") && codes(["zh-Hans-HK"]).contains("zh_CN")
+                && !codes(["zh-Hant-CN"]).contains("zh_CN") && codes(["zh-Hant-CN"]).contains("zh_TW"))
         check(
             "a script-only tag maximizes to reach the same key",
             codes(["zh-Hans"]).contains("zh_CN"))
@@ -219,6 +233,12 @@ struct AppNameTest {
         check(
             "a loctable app is found by its Chinese name, English still indexed",
             names(monitor, ["zh-Hans-CN"]) == ["活动监视器", "Activity Monitor"])
+        check(
+            "a Simplified Chinese Mac outside China still finds Apple's zh_CN name",
+            names(monitor, ["zh-Hans-US"]) == ["活动监视器", "Activity Monitor"])
+        check(
+            "a Traditional Chinese Mac outside Taiwan finds Apple's zh_TW name",
+            names(monitor, ["zh-Hant-US"]) == ["活動監視器", "Activity Monitor"])
         check(
             "an English Mac indexes only the English name",
             names(monitor, ["en-US"]) == ["Activity Monitor"])
diff --git a/Tinycast/Platform/BundleLocalization.swift b/Tinycast/Platform/BundleLocalization.swift
index 9af7fe01..b7d1a167 100644
--- a/Tinycast/Platform/BundleLocalization.swift
+++ b/Tinycast/Platform/BundleLocalization.swift
@@ -25,17 +25,22 @@ enum BundleLocalization {
         language == "nb" ? "no" : nil
     }
 
-    /// Most apps ship a script-bearing tag as `zh-Hans`; Apple keys it by region alone, as `zh_CN`.
     private static func scriptForms(_ tag: String) -> [String] {
         let subtags = tag.split(separator: "-")
         guard subtags.contains(where: { $0.count == 4 && $0.allSatisfy(\.isLetter) })
         else { return [] }
         let language = Locale.Language(identifier: tag)
-        guard let code = language.languageCode?.identifier else { return [] }
-        let region =
-            language.region ?? Locale.Language(identifier: language.maximalIdentifier).region
-        return [language.script?.identifier, region?.identifier].compactMap { $0 }
-            .map { "\(code)-\($0)" }
+        guard let code = language.languageCode?.identifier, let script = language.script
+        else { return [] }
+        let scriptForm = "\(code)-\(script.identifier)"
+        let regionForms = [language.region, maximal(scriptForm).region].compactMap { $0 }
+            .map { "\(code)-\($0.identifier)" }
+            .filter { maximal($0).script == script }
+        return [scriptForm] + regionForms
+    }
+
+    private static func maximal(_ identifier: String) -> Locale.Language {
+        Locale.Language(identifier: Locale.Language(identifier: identifier).maximalIdentifier)
     }
 
     /// Every name the bundle carries, most preferred language first. `base` — an app's file name, a
diff --git a/docs/features/launcher.md b/docs/features/launcher.md
index 96cf85ba..234a3b10 100644
--- a/docs/features/launcher.md
+++ b/docs/features/launcher.md
@@ -201,12 +201,14 @@ which turns into Tinycast's interface language once one is picked, and would ren
 `InfoPlist.strings`, and every app under `/System/Applications` translates in the loctable alone — so
 all 65 of them read English on every Mac, whatever language it is set to.
 
-A tag carrying a script is read under two more codes, because no one folder name covers it: a
-`zh-Hans-CN` Mac also reads `zh-Hans`, the folder most third-party apps ship, then `zh_CN`, the key
-Apple's own loctables use. A script-only `zh-Hans` maximizes to reach the same region. A tag without a
-script otherwise keeps its exact, underscore and bare-language forms. Bokmål (`nb`) additionally
-reads `no` after `nb`, because Apple's Norwegian loctables use that key; an explicit `nb.lproj` still
-wins. Other languages, including Nynorsk (`nn`), gain no alias.
+A tag carrying a script is read under more codes, because no one folder name covers it: a
+`zh-Hans-US` Mac also reads `zh-Hans`, the folder most third-party apps ship, then its own region
+`zh_US`, then `zh_CN`, the script's home region and the key Apple's own loctables use. A region is read
+only when it writes the tag's script, so `zh-Hans-HK` skips the Traditional `zh_HK`, and `zh-Hant-HK`
+reads `zh_HK` before `zh_TW`. A tag without a script otherwise keeps its exact, underscore and
+bare-language forms. Bokmål (`nb`) additionally reads `no` after `nb`, because Apple's Norwegian
+loctables use that key; an explicit `nb.lproj` still wins. Other languages, including Nynorsk (`nn`),
+gain no alias.
 
 The user's own language wins the **display name**, so a row reads the way Finder reads it. The rest,
 English included, ride along as alternate titles, matched as typed and never transliterated.
