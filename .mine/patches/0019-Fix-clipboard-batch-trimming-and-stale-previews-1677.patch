From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Abue Ammar <14371506+abue-ammar@users.noreply.github.com>
Date: Thu, 22 Oct 2026 01:16:30 +0600
Subject: [PATCH] Fix clipboard batch trimming and stale previews (#1677)

---
 Tests/clipboard-test.swift                    | 28 +++++++++++++++++++
 .../Clipboard/Model/ClipboardStore.swift      |  2 +-
 .../Clipboard/UI/FilePreviewStage.swift       | 14 ++++++++--
 3 files changed, 40 insertions(+), 4 deletions(-)

diff --git a/Tests/clipboard-test.swift b/Tests/clipboard-test.swift
index a6c3f8a2..cdafef02 100644
--- a/Tests/clipboard-test.swift
+++ b/Tests/clipboard-test.swift
@@ -31,6 +31,7 @@ struct ClipboardTests {
         imageCopiesLeaveWithTheirBlob()
         orphanedCopiesAreSweptOnLoad()
         multiFileCopyMakesOneRowEach()
+        fileBatchesRespectTheMemoryWindow()
         referencedFilesOutliveTheirRows()
         filePathsAreNeverATextForm()
         fileEntriesAreFoundByNameAndFolder()
@@ -753,6 +754,33 @@ struct ClipboardTests {
         }
     }
 
+    static func fileBatchesRespectTheMemoryWindow() {
+        withStore { store, _ in
+            for index in 0..<1000 { store.addText("entry \(index)", sourceBundleID: nil) }
+            let pinned = item(store, "entry 0")
+            store.togglePinned(pinned)
+
+            for batch in 0..<3 {
+                let paths = (0..<32).map { "/Users/me/batch-\(batch)-\($0).txt" }
+                store.addFiles(paths, sourceBundleID: nil)
+                expect(store.items.count == 1000, "each file batch keeps the window bounded")
+                expect(
+                    store.items.prefix(paths.count).compactMap(\.filePath) == paths.reversed(),
+                    "the entire new batch stays in recency order")
+                expect(
+                    store.items.contains { $0.id == pinned.id && $0.isPinned },
+                    "trimming preserves the oldest pin")
+            }
+
+            expect(
+                store.items.last(where: { !$0.isPinned })?.text == "entry 97",
+                "trimming removes the oldest unpinned rows")
+            expect(
+                store.search("entry 1", filter: .text).contains { $0.text == "entry 1" },
+                "trimmed rows remain searchable on disk")
+        }
+    }
+
     /// The one that matters: a file we only referenced is never ours to delete.
     static func referencedFilesOutliveTheirRows() {
         withStore { store, dir in
diff --git a/Tinycast/Features/Clipboard/Model/ClipboardStore.swift b/Tinycast/Features/Clipboard/Model/ClipboardStore.swift
index b07725d6..3cfdd18d 100644
--- a/Tinycast/Features/Clipboard/Model/ClipboardStore.swift
+++ b/Tinycast/Features/Clipboard/Model/ClipboardStore.swift
@@ -372,8 +372,8 @@ final class ClipboardStore {
             let item = ClipboardItem(filePath: path, sourceBundleID: sourceBundleID)
             if let stmt = insertStmt { Self.bindAndInsert(stmt, item) }
             items.insert(item, at: 0)
+            trimWindow()
         }
-        trimWindow()
         prune()
     }
 
diff --git a/Tinycast/Features/Clipboard/UI/FilePreviewStage.swift b/Tinycast/Features/Clipboard/UI/FilePreviewStage.swift
index 8deca895..6884bb7a 100644
--- a/Tinycast/Features/Clipboard/UI/FilePreviewStage.swift
+++ b/Tinycast/Features/Clipboard/UI/FilePreviewStage.swift
@@ -16,7 +16,11 @@ struct FilePreviewStage: View {
     private var url: URL { URL(filePath: path, directoryHint: .inferFromPath) }
 
     var body: some View {
-        stage.task(id: path) { probe = await Self.probe(path) }
+        stage.task(id: path) {
+            let loaded = await Self.probe(path)
+            guard !Task.isCancelled else { return }
+            probe = loaded
+        }
     }
 
     @ViewBuilder private var stage: some View {
@@ -90,7 +94,9 @@ private struct FileThumbnailStage: View {
                 return
             }
             image = nil
-            image = await FilePreviewThumbnail.loadAsync(url, maxPixel: maxPixel)
+            let loaded = await FilePreviewThumbnail.loadAsync(url, maxPixel: maxPixel)
+            guard !Task.isCancelled else { return }
+            image = loaded
         }
     }
 }
@@ -177,7 +183,9 @@ private struct AudioPoster: View {
             }
         }
         .task(id: url) {
-            image = await FilePreviewThumbnail.loadAsync(url, maxPixel: 300)
+            let loaded = await FilePreviewThumbnail.loadAsync(url, maxPixel: 300)
+            guard !Task.isCancelled else { return }
+            image = loaded
         }
     }
 }
