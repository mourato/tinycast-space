+++ b/Tinycast/Features/AI/Model/ContextSource.swift
@@ -0,0 +1,76 @@
+import Foundation
+
+/// One place a chat may quote. Pure, so a harness pins it rather than a pane.
+enum ContextSource: String, CaseIterable, Identifiable, Sendable {
+    case browserTabs
+    case apps
+    case actions
+    case integrations
+    case tools
+    case memoryGroups
+    case variables
+
+    var id: String { rawValue }
+
+    var title: String {
+        switch self {
+        case .browserTabs: return "Browser tabs"
+        case .apps: return "Apps"
+        case .actions: return "Actions"
+        case .integrations: return "Integrations"
+        case .tools: return "Tools"
+        case .memoryGroups: return "Memory groups"
+        case .variables: return "Variables"
+        }
+    }
+
+    var defaultPriority: Double {
+        switch self {
+        case .browserTabs: return 1.0
+        case .apps: return 0.9
+        case .actions: return 0.8
+        case .integrations: return 0.7
+        case .tools: return 0.6
+        case .memoryGroups: return 0.5
+        case .variables: return 0.4
+        }
+    }
+
+    /// Memory groups and variables have no engine in this build, so they offer no rows.
+    var isAvailable: Bool {
+        switch self {
+        case .memoryGroups, .variables: return false
+        default: return true
+        }
+    }
+
+    var unavailableReason: String? {
+        switch self {
+        case .memoryGroups: return "Memory groups aren't available in this build."
+        case .variables: return "Variables aren't available in this build."
+        default: return nil
+        }
+    }
+
+    /// Priorities stay inside the unit interval; anything else repairs to the default.
+    static func normalized(priority: Double, for source: ContextSource) -> Double {
+        guard priority.isFinite, priorityRange.contains(priority) else {
+            return source.defaultPriority
+        }
+        return priority
+    }
+
+    static let priorityRange = 0.0...1.0
+
+    var menuSymbol: String {
+        switch self {
+        case .browserTabs: return "globe"
+        case .apps: return "app.window"
+        case .actions: return "wand.and.sparkles"
+        case .integrations: return "puzzlepiece.extension"
+        case .tools: return "wrench.and.screwdriver"
+        case .memoryGroups: return "brain"
+        case .variables: return "curlybraces"
+        }
+    }
+}
diff --git a/Tinycast/Features/AI/Service/ContextAppReader.swift b/Tinycast/Features/AI/Service/ContextAppReader.swift
new file mode 100644
index 00000000..106ad4a2
--- /dev/null
+++ b/Tinycast/Features/AI/Service/ContextAppReader.swift
@@ -0,0 +1,210 @@
+import AppKit
+import ApplicationServices
+import Carbon.HIToolbox
+
+/// Reads the app behind the palette or chat: metadata plus bounded accessible text. Off-main.
+nonisolated enum ContextAppReader {
+    /// Captured on-main before Tinycast takes focus, so the target can never be the composer.
+    struct Snapshot: Sendable {
+        let processIdentifier: pid_t
+        let bundleIdentifier: String?
+        let name: String
+        let isBrowser: Bool
+
+        var sourceKey: String {
+            if let bundleIdentifier, !bundleIdentifier.isEmpty { return "app:\(bundleIdentifier)" }
+            return "app:pid-\(processIdentifier)"
+        }
+    }
+
+    struct Read: Sendable {
+        let selection: String?
+        /// Focused text when nothing is selected and the caller asked for the whole window.
+        let value: String?
+        let windowTitle: String?
+        /// Secure input or a secure field refused the text; the title may still be quoted.
+        let skippedSecureInput: Bool
+        /// Accessibility trust is missing, so nothing was read; the UI explains the grant.
+        let accessDenied: Bool
+        /// The focused window moved mid-read, so the text is dropped, never half-quoted.
+        let windowChanged: Bool
+        /// The value or selection was cut to the bound before staging saw it.
+        let isTruncated: Bool
+
+        init(
+            selection: String? = nil, value: String? = nil, windowTitle: String? = nil,
+            skippedSecureInput: Bool = false, accessDenied: Bool = false,
+            windowChanged: Bool = false, isTruncated: Bool = false
+        ) {
+            self.selection = selection
+            self.value = value
+            self.windowTitle = windowTitle
+            self.skippedSecureInput = skippedSecureInput
+            self.accessDenied = accessDenied
+            self.windowChanged = windowChanged
+            self.isTruncated = isTruncated
+        }
+    }
+
+    static let maxValueChars = 4_000
+    static let maxTitleChars = 120
+
+    static var browserBundleURLs: Set<URL> {
+        guard let probe = URL(string: "https://example.invalid") else { return [] }
+        return Set(NSWorkspace.shared.urlsForApplications(toOpen: probe).map(\.standardizedFileURL))
+    }
+
+    /// Nil for Tinycast itself: app context never means the composer asking about itself.
+    static func snapshot(of app: NSRunningApplication?) -> Snapshot? {
+        guard let app, app.processIdentifier != NSRunningApplication.current.processIdentifier
+        else { return nil }
+        if let bundle = app.bundleIdentifier, bundle.hasPrefix("com.tinycast.app") { return nil }
+        let handlesWebURLs = app.bundleURL.map { browserBundleURLs.contains($0.standardizedFileURL) } ?? false
+        let isBrowser = ContextBrowser.isSupported(bundleID: app.bundleIdentifier) || handlesWebURLs
+        return Snapshot(
+            processIdentifier: app.processIdentifier, bundleIdentifier: app.bundleIdentifier,
+            name: app.localizedName ?? "Unknown App", isBrowser: isBrowser)
+    }
+
+    /// Blocking AX walks stay here, never on the main actor; every call carries its own timeout.
+    @concurrent static func read(_ snapshot: Snapshot) async -> Read {
+        let empty = Read()
+        guard !snapshot.isBrowser, !Task.isCancelled else { return empty }
+        if IsSecureEventInputEnabled() {
+            return Read(skippedSecureInput: true)
+        }
+        guard AXIsProcessTrusted() else { return Read(accessDenied: true) }
+        guard
+            let app = NSRunningApplication(processIdentifier: snapshot.processIdentifier),
+            !app.isTerminated, app.bundleIdentifier == snapshot.bundleIdentifier
+        else { return empty }
+        let application = AXUIElementCreateApplication(snapshot.processIdentifier)
+        AXUIElementSetMessagingTimeout(application, 1)
+        AXUIElementSetAttributeValue(
+            application, "AXManualAccessibility" as CFString, kCFBooleanTrue)
+        guard !Task.isCancelled, let element = focusedElement(in: application) else { return empty }
+        if isSecure(element) {
+            return Read(
+                windowTitle: windowTitle(in: application), skippedSecureInput: true)
+        }
+        guard let before = windowElement(for: element) else { return empty }
+        let (selection, selectionCut) = selectedText(in: element)
+        let (value, valueCut) = valueText(in: element)
+        guard windowStill(before, in: application) else { return Read(windowChanged: true) }
+        return Read(
+            selection: selection, value: value, windowTitle: windowTitle(in: application),
+            isTruncated: selectionCut || valueCut)
+    }
+
+    private static func focusedElement(in application: AXUIElement) -> AXUIElement? {
+        guard !Task.isCancelled else { return nil }
+        var focusedValue: CFTypeRef?
+        guard
+            AXUIElementCopyAttributeValue(
+                application, kAXFocusedUIElementAttribute as CFString, &focusedValue) == .success,
+            let focusedValue, CFGetTypeID(focusedValue) == AXUIElementGetTypeID()
+        else { return nil }
+        let element = unsafeDowncast(focusedValue as AnyObject, to: AXUIElement.self)
+        AXUIElementSetMessagingTimeout(element, 1)
+        return element
+    }
+
+    private static func isSecure(_ element: AXUIElement) -> Bool {
+        guard !Task.isCancelled else { return true }
+        var role: CFTypeRef?
+        guard
+            AXUIElementCopyAttributeValue(element, kAXRoleAttribute as CFString, &role) == .success,
+            let role = role as? String
+        else { return false }
+        if role.localizedCaseInsensitiveContains("secure") { return true }
+        guard !Task.isCancelled else { return true }
+        var subrole: CFTypeRef?
+        guard
+            AXUIElementCopyAttributeValue(element, kAXSubroleAttribute as CFString, &subrole)
+                == .success,
+            let subrole = subrole as? String
+        else { return false }
+        return subrole == (kAXSecureTextFieldSubrole as String)
+    }
+
+    private static func selectedText(in element: AXUIElement) -> (String?, Bool) {
+        if let direct = selectedString(in: element) { return boundedSelection(direct) }
+        guard !Task.isCancelled else { return (nil, false) }
+        var range: CFTypeRef?
+        guard
+            AXUIElementCopyAttributeValue(
+                element, kAXSelectedTextMarkerRangeAttribute as CFString, &range) == .success,
+            let range, CFGetTypeID(range) == AXTextMarkerRangeGetTypeID()
+        else { return (nil, false) }
+        var web: CFTypeRef?
+        guard
+            !Task.isCancelled,
+            AXUIElementCopyParameterizedAttributeValue(
+                element, kAXStringForTextMarkerRangeParameterizedAttribute as CFString, range,
+                &web) == .success,
+            let text = web as? String, !text.isEmpty
+        else { return (nil, false) }
+        return boundedSelection(text)
+    }
+
+    private static func selectedString(in element: AXUIElement) -> String? {
+        guard !Task.isCancelled else { return nil }
+        var value: CFTypeRef?
+        guard
+            AXUIElementCopyAttributeValue(element, kAXSelectedTextAttribute as CFString, &value)
+                == .success,
+            let text = value as? String, !text.isEmpty
+        else { return nil }
+        return text
+    }
+
+    private static func boundedSelection(_ text: String) -> (String?, Bool) {
+        guard text.count > maxValueChars else { return (text, false) }
+        return (String(text.prefix(maxValueChars)), true)
+    }
+
+    private static func valueText(in element: AXUIElement) -> (String?, Bool) {
+        guard !Task.isCancelled else { return (nil, false) }
+        var value: CFTypeRef?
+        guard
+            AXUIElementCopyAttributeValue(element, kAXValueAttribute as CFString, &value) == .success,
+            let text = value as? String, !text.isEmpty
+        else { return (nil, false) }
+        guard text.count > maxValueChars else { return (text, false) }
+        return (String(text.prefix(maxValueChars)), true)
+    }
+
+    /// The focused element's window, so a mid-read window switch drops the quote, never mixes it.
+    private static func windowElement(for element: AXUIElement) -> AXUIElement? {
+        guard !Task.isCancelled else { return nil }
+        var window: CFTypeRef?
+        guard
+            AXUIElementCopyAttributeValue(element, kAXWindowAttribute as CFString, &window)
+                == .success,
+            let window, CFGetTypeID(window) == AXUIElementGetTypeID()
+        else { return nil }
+        return unsafeDowncast(window as AnyObject, to: AXUIElement.self)
+    }
+
+    private static func windowStill(_ before: AXUIElement, in application: AXUIElement) -> Bool {
+        guard let element = focusedElement(in: application),
+            let after = windowElement(for: element)
+        else { return false }
+        return CFEqual(before, after)
+    }
+
+    private static func windowTitle(in application: AXUIElement) -> String? {
+        guard let element = focusedElement(in: application),
+            let windowElement = windowElement(for: element)
+        else { return nil }
+        AXUIElementSetMessagingTimeout(windowElement, 1)
+        guard !Task.isCancelled else { return nil }
+        var title: CFTypeRef?
+        guard
+            AXUIElementCopyAttributeValue(windowElement, kAXTitleAttribute as CFString, &title)
+                == .success,
+            let text = title as? String, !text.isEmpty
+        else { return nil }
+        return String(text.prefix(maxTitleChars))
+    }
+}
diff --git a/Tinycast/Features/AI/Service/ContextBrowserRunner.swift b/Tinycast/Features/AI/Service/ContextBrowserRunner.swift
new file mode 100644
index 00000000..ff6acca3
--- /dev/null
+++ b/Tinycast/Features/AI/Service/ContextBrowserRunner.swift
@@ -0,0 +1,239 @@
+import AppKit
+import Foundation
+
+/// AppleScript against the supported browsers, off-main, returning Sendable values.
+enum ContextBrowserRunner {
+    /// Every tab of every normal window, front to back, plus whether the front window is private.
+    struct TabList: Sendable {
+        let browser: ContextBrowser.Browser
+        let tabs: [ContextBrowser.BrowserTab]
+        let frontIsPrivate: Bool
+    }
+
+    /// Never launches a browser to ask it: only running ones are candidates.
+    static func targetBrowser(preferred: String?) -> ContextBrowser.Browser? {
+        let running = NSWorkspace.shared.runningApplications.compactMap {
+            $0.isTerminated ? nil : $0.bundleIdentifier
+        }
+        return ContextBrowser.target(preferred: preferred, running: running)
+    }
+
+    private static func isRunning(_ bundleID: String) -> Bool {
+        NSWorkspace.shared.runningApplications.contains {
+            $0.bundleIdentifier == bundleID && !$0.isTerminated
+        }
+    }
+
+    /// Every tab of every normal window, front to back; private windows never listed.
+    static func listTabs(
+        preferredBundleID: String?
+    ) async -> Result<TabList, ContextBrowser.ReadFailure> {
+        guard !Task.isCancelled, let browser = targetBrowser(preferred: preferredBundleID) else {
+            return .failure(.noSource)
+        }
+        let rows = await runList(script: listScript(for: browser), browser: browser)
+        switch rows {
+        case .failure(let failure): return .failure(failure)
+        case .success(let rows):
+            return .success(
+                TabList(
+                    browser: browser,
+                    tabs: ContextBrowser.tabs(from: rows, bundleID: browser.bundleID),
+                    frontIsPrivate: ContextBrowser.frontIsPrivate(rows: rows)))
+        }
+    }
+
+    /// Reads one listed tab; a moved tab is stale, never substituted.
+    static func readTab(
+        _ tab: ContextBrowser.BrowserTab
+    ) async -> Result<ContextBrowser.PageRead, ContextBrowser.ReadFailure> {
+        guard !Task.isCancelled, let browser = ContextBrowser.browser(bundleID: tab.bundleID),
+            isRunning(browser.bundleID)
+        else { return .failure(.noSource) }
+        guard let script = readScript(for: browser, tab: tab) else { return .failure(.staleTab) }
+        let result = await runScalar(script: script, browser: browser)
+        switch result {
+        case .failure(let failure): return .failure(failure)
+        case .success(let text):
+            if text == "NOTFOUND" || text.isEmpty { return .failure(.staleTab) }
+            if text == "INCOGNITO" { return .failure(.restrictedPage) }
+            if text == "LOADING" { return .failure(.loading) }
+            guard let read = ContextBrowser.parsePageRead(text) else {
+                return .failure(.restrictedPage)
+            }
+            guard ContextBrowser.verified(read, expectedURL: tab.url) else {
+                return .failure(.staleTab)
+            }
+            let hasText =
+                !read.selection.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+                || !read.body.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+            guard hasText else { return .failure(.empty) }
+            return .success(read)
+        }
+    }
+
+    private static func listScript(for browser: ContextBrowser.Browser) -> String {
+        let app = ContextBrowser.appleScriptLiteral(browser.bundleID)
+        switch browser.family {
+        case .chromium:
+            return """
+                with timeout of \(ContextBrowser.captureTimeoutSeconds) seconds
+                tell application id \(app)
+                set out to {}
+                repeat with w in windows
+                set wmode to mode of w
+                set wid to (id of w) as text
+                if wmode is "incognito" then
+                set end of out to {"", wid, "0", "", "", wmode}
+                else
+                try
+                set activeID to (id of active tab of w) as text
+                on error
+                set activeID to ""
+                end try
+                repeat with t in tabs of w
+                set tid to (id of t) as text
+                if tid is activeID then
+                set flag to "1"
+                else
+                set flag to "0"
+                end if
+                set end of out to {tid, wid, flag, title of t, URL of t, wmode}
+                end repeat
+                end if
+                end repeat
+                return out
+                end tell
+                end timeout
+                """
+        case .safari:
+            return """
+                with timeout of \(ContextBrowser.captureTimeoutSeconds) seconds
+                tell application id \(app)
+                set out to {}
+                repeat with w in windows
+                try
+                set wid to (id of w) as text
+                set cur to index of current tab of w
+                repeat with t in tabs of w
+                try
+                set ti to index of t
+                if ti is cur then
+                set flag to "1"
+                else
+                set flag to "0"
+                end if
+                set end of out to {ti as text, wid, flag, name of t, URL of t, "normal"}
+                end try
+                end repeat
+                end try
+                end repeat
+                return out
+                end tell
+                end timeout
+                """
+        }
+    }
+
+    /// Safari has no tab id, so its read re-checks the URL at that index before running anything.
+    private static func readScript(
+        for browser: ContextBrowser.Browser, tab: ContextBrowser.BrowserTab
+    ) -> String? {
+        let app = ContextBrowser.appleScriptLiteral(browser.bundleID)
+        let tid = ContextBrowser.appleScriptLiteral(tab.id)
+        let wid = ContextBrowser.appleScriptLiteral(tab.windowID)
+        let url = ContextBrowser.appleScriptLiteral(tab.url)
+        let js = ContextBrowser.appleScriptLiteral(ContextBrowser.readerJavaScript)
+        switch browser.family {
+        case .chromium:
+            return """
+                with timeout of \(ContextBrowser.captureTimeoutSeconds) seconds
+                tell application id \(app)
+                repeat with w in windows
+                if ((id of w) as text) is \(wid) then
+                if mode of w is "incognito" then return "INCOGNITO"
+                repeat with t in tabs of w
+                if ((id of t) as text) is \(tid) then
+                if loading of t is true then return "LOADING"
+                return execute t javascript \(js)
+                end if
+                end repeat
+                end if
+                end repeat
+                return "NOTFOUND"
+                end tell
+                end timeout
+                """
+        case .safari:
+            guard let index = Int(tab.id), index > 0 else { return nil }
+            return """
+                with timeout of \(ContextBrowser.captureTimeoutSeconds) seconds
+                tell application id \(app)
+                repeat with w in windows
+                if ((id of w) as text) is \(wid) then
+                if (count of tabs of w) < \(index) then return "NOTFOUND"
+                set t to tab \(index) of w
+                if (URL of t) is not \(url) then return "NOTFOUND"
+                return do JavaScript \(js) in t
+                end if
+                end repeat
+                return "NOTFOUND"
+                end tell
+                end timeout
+                """
+        }
+    }
+
+    @concurrent private static func runScalar(
+        script: String, browser: ContextBrowser.Browser
+    ) async -> Result<String, ContextBrowser.ReadFailure> {
+        guard !Task.isCancelled, let compiled = NSAppleScript(source: script) else {
+            return .failure(.noSource)
+        }
+        guard !Task.isCancelled else { return .failure(.noSource) }
+        var errorInfo: NSDictionary?
+        let result = compiled.executeAndReturnError(&errorInfo)
+        guard !Task.isCancelled else { return .failure(.noSource) }
+        if let errorInfo { return .failure(mapError(errorInfo, browser: browser)) }
+        return .success(result.stringValue ?? "")
+    }
+
+    @concurrent private static func runList(
+        script: String, browser: ContextBrowser.Browser
+    ) async -> Result<[[String]], ContextBrowser.ReadFailure> {
+        guard !Task.isCancelled, let compiled = NSAppleScript(source: script) else {
+            return .failure(.noSource)
+        }
+        guard !Task.isCancelled else { return .failure(.noSource) }
+        var errorInfo: NSDictionary?
+        let result = compiled.executeAndReturnError(&errorInfo)
+        guard !Task.isCancelled else { return .failure(.noSource) }
+        if let errorInfo { return .failure(mapError(errorInfo, browser: browser)) }
+        var rows: [[String]] = []
+        let rowCount = result.numberOfItems
+        if rowCount > 0 {
+            for index in 1...rowCount {
+                guard !Task.isCancelled else { return .failure(.noSource) }
+                guard let row = result.atIndex(index) else { continue }
+                var fields: [String] = []
+                let fieldCount = row.numberOfItems
+                if fieldCount > 0 {
+                    for field in 1...fieldCount {
+                        fields.append(row.atIndex(field)?.stringValue ?? "")
+                    }
+                }
+                rows.append(fields)
+            }
+        }
+        return .success(rows)
+    }
+
+    /// Descriptors never cross the await; only strings and the mapped failure do.
+    static func mapError(
+        _ errorInfo: NSDictionary, browser: ContextBrowser.Browser
+    ) -> ContextBrowser.ReadFailure {
+        ContextBrowser.failure(
+            errorNumber: errorInfo[NSAppleScript.errorNumber] as? Int,
+            message: errorInfo[NSAppleScript.errorMessage] as? String ?? "", browser: browser)
+    }
+}
