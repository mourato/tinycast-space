From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kosuketut <g2125031cd@edu.teu.ac.jp>
Date: Sat, 17 Oct 2026 18:59:21 +0900
Subject: [PATCH] Stop extension shortcut handlers from retaining closed
 screens (#1626)

ExtensionShortcutKeys captured the whole ExtensionCommandScreen in its
onKeyPress closure. SwiftUI keeps a stale key handler from each command
session alive, so every closed extension left its last screen (rows,
render tree) in memory: Kill Process grew Tinycast by about 13 MB per
open in a release build. Resolve the screen when the key is pressed.
---
 .../Features/Extensions/UI/ExtensionPaletteModifiers.swift   | 5 +++--
 Tinycast/Palette/RootPaletteView.swift                       | 2 +-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/Tinycast/Features/Extensions/UI/ExtensionPaletteModifiers.swift b/Tinycast/Features/Extensions/UI/ExtensionPaletteModifiers.swift
index bab522df..07118b67 100644
--- a/Tinycast/Features/Extensions/UI/ExtensionPaletteModifiers.swift
+++ b/Tinycast/Features/Extensions/UI/ExtensionPaletteModifiers.swift
@@ -2,12 +2,13 @@ import SwiftUI
 
 /// An action's own shortcut, matched before the palette's bindings see it.
 struct ExtensionShortcutKeys: ViewModifier {
-    let screen: ExtensionCommandScreen?
+    /// Resolved per press: SwiftUI keeps stale key handlers, and a captured screen keeps its rows.
+    let screen: () -> ExtensionCommandScreen?
     let selection: Int
 
     func body(content: Content) -> some View {
         content.onKeyPress(phases: .down) { press in
-            guard let screen, !press.modifiers.isEmpty else { return .ignored }
+            guard !press.modifiers.isEmpty, let screen = screen() else { return .ignored }
             return screen.dispatchShortcut(
                 key: ASCIIKeyboardLayout.keyEquivalent(fallingBackTo: press.key),
                 modifiers: press.modifiers,
diff --git a/Tinycast/Palette/RootPaletteView.swift b/Tinycast/Palette/RootPaletteView.swift
index 9c4c05e2..c9a6a359 100644
--- a/Tinycast/Palette/RootPaletteView.swift
+++ b/Tinycast/Palette/RootPaletteView.swift
@@ -598,7 +598,7 @@ struct RootPaletteView: View {
             }
             .modifier(
                 ExtensionShortcutKeys(
-                    screen: menuOpen ? nil : screen as? ExtensionCommandScreen, selection: sel)
+                    screen: { menuOpen ? nil : screen as? ExtensionCommandScreen }, selection: sel)
             )
             .onKeyPress(phases: .down) { press in
                 guard press.modifiers.contains(.command),
-- 
