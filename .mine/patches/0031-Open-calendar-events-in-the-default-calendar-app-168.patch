From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jonas List <Jonas.List.1289@gmail.com>
Date: Fri, 23 Oct 2026 00:31:31 +0200
Subject: [PATCH] Open calendar events in the default calendar app (#1689)

---
 Tinycast/Features/Calendar/Service/MeetingLauncher.swift | 9 ++++++++-
 docs/features/calendar.md                                | 2 +-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/Tinycast/Features/Calendar/Service/MeetingLauncher.swift b/Tinycast/Features/Calendar/Service/MeetingLauncher.swift
index 22a1d712..165d632e 100644
--- a/Tinycast/Features/Calendar/Service/MeetingLauncher.swift
+++ b/Tinycast/Features/Calendar/Service/MeetingLauncher.swift
@@ -44,10 +44,17 @@ enum MeetingLauncher {
     @MainActor
     @discardableResult
     static func showInCalendar(_ event: MeetingEvent) -> Bool {
+        let workspace = NSWorkspace.shared
         guard
             let url = URL(
                 string: "ical://ekevent/\(event.calendarItemID)?method=show&options=more")
         else { return false }
-        return NSWorkspace.shared.open(url)
+        // The default calendar app owns webcal; only Calendar.app reads ical:// links.
+        if let webcal = URL(string: "webcal://"), let app = workspace.urlForApplication(toOpen: webcal),
+            app != workspace.urlForApplication(toOpen: url)
+        {
+            return workspace.open(app)
+        }
+        return workspace.open(url)
     }
 }
diff --git a/docs/features/calendar.md b/docs/features/calendar.md
index f31c2f92..f2e66c89 100644
--- a/docs/features/calendar.md
+++ b/docs/features/calendar.md
@@ -156,7 +156,7 @@ the option to hide a current event immediately or after a chosen delay.
 | My Schedule | Opens the `.schedule` palette mode. | yes |
 | Create Event | Opens the launcher form for a title, a start and a duration, and writes the event. | yes |
 | Copy Meeting Link | The same meeting's link, to the pasteboard. | no |
-| Open in Calendar | Hands the meeting to Calendar.app. | no |
+| Open in Calendar | Hands the meeting to Calendar.app, or opens another default calendar app. | no |
 
 **A command that opens a surface is bindable**; the two that act on the next meeting are reached
 through the join card's own ⌘K menu instead, where the meeting they act on is on screen.
-- 
