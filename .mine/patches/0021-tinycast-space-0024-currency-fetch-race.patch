From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tinycast Recipe <recipe@localhost>
Date: Sat, 24 Oct 2026 12:45:37 -0300
Subject: [PATCH] tinycast-space 0024: currency fetch race

Calculator: `CurrencyRateStore` drops a rate fetch that a newer one superseded (the daily pump and the refresh button can overlap), so older rates never overwrite fresher ones. From [mSarheed/pipcast](https://github.com/mSarheed/pipcast/commit/661c57f8).
Origin: tinycast-space 0024-currency-fetch-race.patch @ ffccfc3
---
 .../Features/Calculator/Service/CurrencyRateStore.swift     | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Tinycast/Features/Calculator/Service/CurrencyRateStore.swift b/Tinycast/Features/Calculator/Service/CurrencyRateStore.swift
index 419b8206..4bcefedf 100644
--- a/Tinycast/Features/Calculator/Service/CurrencyRateStore.swift
+++ b/Tinycast/Features/Calculator/Service/CurrencyRateStore.swift
@@ -22,6 +22,8 @@ final class CurrencyRateStore {
     @ObservationIgnored private var pump: Task<Void, Never>?
     /// Drives the schedule: a partial snapshot answers, but only a whole one resets the clock.
     @ObservationIgnored private var completedAt: Date?
+    /// The pump and a manual refresh can overlap; only the latest fetch started may land.
+    @ObservationIgnored private var fetchGeneration = 0
 
     init() {
         fileURL = AppPaths.caches().appendingPathComponent("currency-rates.json")
@@ -62,7 +64,9 @@ final class CurrencyRateStore {
 
     @discardableResult
     private func fetchAndStore() async -> Bool {
-        guard let result = await Self.fetch() else { return false }
+        fetchGeneration &+= 1
+        let generation = fetchGeneration
+        guard let result = await Self.fetch(), generation == fetchGeneration else { return false }
         rates = result.rates
         // Never persist a coin-less run: `pricesCoins` reads the cache as whole by definition.
         guard result.complete, let data = try? JSONEncoder().encode(result.rates) else { return false }
