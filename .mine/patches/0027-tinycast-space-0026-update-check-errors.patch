 Tests/update-check-test.swift                 | 63 ++++++++++++++++---
 .../Updates/Service/UpdateCheckStore.swift    | 56 +++++++++++++----
 .../Updates/Service/UpdateFailure.swift       |  5 ++
 .../Updates/UI/UpdateCoordinator.swift        | 13 ++--
 .../Updates/UI/UpdateWindowView.swift         |  1 +
 6 files changed, 114 insertions(+), 25 deletions(-)

