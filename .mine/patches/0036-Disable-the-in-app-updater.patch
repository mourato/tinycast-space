From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Renato <remourato@gmail.com>
Date: Sat, 10 Oct 2026 17:22:18 -0300
Subject: [PATCH] Disable the in-app updater

Local builds of this fork never update themselves: the update store always
runs on the development channel, so Check for Updates is hidden and a
Space Edition release can never replace a locally built copy.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Tinycast/Features/Updates/Service/UpdateCheckStore.swift | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Tinycast/Features/Updates/Service/UpdateCheckStore.swift b/Tinycast/Features/Updates/Service/UpdateCheckStore.swift
index d6c31356..50a342ed 100644
--- a/Tinycast/Features/Updates/Service/UpdateCheckStore.swift
+++ b/Tinycast/Features/Updates/Service/UpdateCheckStore.swift
@@ -37,7 +37,9 @@ final class UpdateCheckStore {
     @ObservationIgnored private var pump: Task<Void, Never>?
 
     init(
-        channel: ReleaseChannel = ReleaseChannel(bundleID: Bundle.main.bundleIdentifier),
+        // mourato: builds of this fork are installed locally and never update themselves, so a
+        // Space release never replaces them. Rebuild with `make update` / `make install`.
+        channel: ReleaseChannel = .development,
         runningVersion: AppVersion? = (Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String)
             .flatMap(AppVersion.init),
         fileURL: URL = AppPaths.caches().appendingPathComponent("update-check.json"),
-- 
