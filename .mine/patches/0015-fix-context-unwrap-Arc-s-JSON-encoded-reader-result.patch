From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Renato <remourato@gmail.com>
Date: Thu, 15 Oct 2026 00:10:48 -0300
Subject: [PATCH] fix(context): unwrap Arc's JSON-encoded reader result

Arc's execute javascript returns its result JSON-encoded, so every Arc read
failed the object check and reported a restricted page.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Tests/context-test.swift                              |  6 ++++++
 Tinycast/Features/AI/Model/ContextBrowser.swift       | 11 ++++++++++-
 .../Features/AI/Service/ContextBrowserRunner.swift    |  2 +-
 3 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/Tests/context-test.swift b/Tests/context-test.swift
index 17f54df1..fb7f4b6d 100644
--- a/Tests/context-test.swift
+++ b/Tests/context-test.swift
@@ -466,6 +466,12 @@ struct ContextTests {
             ContextBrowser.parsePageRead("{\"e\":\"blocked\"}") == nil,
             "a page error parses as a failure")
         expect(ContextBrowser.parsePageRead("not json") == nil, "garbage never parses")
+        let arcWrapped = ContextBrowser.parsePageRead(
+            "\"{\\\"t\\\":\\\"T\\\",\\\"u\\\":\\\"https://example.com/a\\\",\\\"b\\\":\\\"hi\\\"}\"")
+        expect(arcWrapped?.body == "hi", "Arc's JSON-encoded reader report parses like a raw one")
+        expect(
+            ContextBrowser.parsePageRead("\"plain\"") == nil,
+            "a wrapped non-object never parses")
         expect(
             ContextBrowser.parsePageRead("{\"t\":\"x\"}") == nil,
             "a read without a URL never parses")
diff --git a/Tinycast/Features/AI/Model/ContextBrowser.swift b/Tinycast/Features/AI/Model/ContextBrowser.swift
index 0492ab47..dea40d8b 100644
--- a/Tinycast/Features/AI/Model/ContextBrowser.swift
+++ b/Tinycast/Features/AI/Model/ContextBrowser.swift
@@ -132,9 +132,18 @@ enum ContextBrowser {
         let isTruncated: Bool
     }
 
+    /// Arc JSON-encodes what `execute` returns, so its reader report arrives as a string literal.
+    static func unwrappedScriptResult(_ text: String) -> String {
+        guard text.hasPrefix("\""), let data = text.data(using: .utf8),
+            let inner = try? JSONSerialization.jsonObject(with: data, options: .fragmentsAllowed)
+                as? String
+        else { return text }
+        return inner
+    }
+
     /// Parses the fixed reader's JSON; anything else is a restricted or failed page.
     static func parsePageRead(_ json: String) -> PageRead? {
-        guard let data = json.data(using: .utf8),
+        guard let data = unwrappedScriptResult(json).data(using: .utf8),
             let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
             object["e"] == nil,
             let url = object["u"] as? String, !url.isEmpty
diff --git a/Tinycast/Features/AI/Service/ContextBrowserRunner.swift b/Tinycast/Features/AI/Service/ContextBrowserRunner.swift
index a24ff921..ff6acca3 100644
--- a/Tinycast/Features/AI/Service/ContextBrowserRunner.swift
+++ b/Tinycast/Features/AI/Service/ContextBrowserRunner.swift
@@ -58,7 +58,7 @@ enum ContextBrowserRunner {
             if text == "NOTFOUND" || text.isEmpty { return .failure(.staleTab) }
             if text == "INCOGNITO" { return .failure(.restrictedPage) }
             if text == "LOADING" { return .failure(.loading) }
-            guard text.hasPrefix("{"), let read = ContextBrowser.parsePageRead(text) else {
+            guard let read = ContextBrowser.parsePageRead(text) else {
                 return .failure(.restrictedPage)
             }
             guard ContextBrowser.verified(read, expectedURL: tab.url) else {
-- 
