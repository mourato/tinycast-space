From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Abue Ammar <14371506+abue-ammar@users.noreply.github.com>
Date: Fri, 23 Oct 2026 05:15:20 +0600
Subject: [PATCH] Send Apple Intelligence chats no instructions (#1693)

The on-device model is small enough that any standing instruction steers
every answer toward it: asked a date question, it described Tinycast.
AIInstructions.compose now returns nil for the on-device route, so its
turns carry the conversation alone: no preamble, no request for
suggested replies and no user system prompt. Every other route is
unchanged, and chat titles still use their own side request.
---
 Tests/ai-provider-test.swift                    | 16 +++++++++++++---
 Tinycast/Features/AI/Model/AIInstructions.swift |  8 +++++---
 Tinycast/Features/AI/UI/AIChatCoordinator.swift |  9 +++++----
 docs/features/ai.md                             | 17 ++++++++++-------
 4 files changed, 33 insertions(+), 17 deletions(-)

diff --git a/Tests/ai-provider-test.swift b/Tests/ai-provider-test.swift
index 9e22a2f5..d9ab7438 100644
--- a/Tests/ai-provider-test.swift
+++ b/Tests/ai-provider-test.swift
@@ -16,22 +16,32 @@ struct AIProviderTests {
     }
 
     static func instructionsFollowTheSetting() {
+        let cloud = AIModelSelection.codex(model: "gpt-5", effort: nil)
         for prompt in [nil, "", "   \n\t "] as [String?] {
             expect(
-                AIInstructions.compose(userPrompt: prompt, isEnabled: true, offersChoices: false)
+                AIInstructions.compose(
+                    userPrompt: prompt, isEnabled: true, offersChoices: false, model: cloud)
                     == AIPreamble.text,
                 "an absent or blank user prompt with choices off sends the preamble alone")
         }
         expect(
             AIInstructions.compose(
-                userPrompt: "  Answer only in haiku.  ", isEnabled: true, offersChoices: true)
+                userPrompt: "  Answer only in haiku.  ", isEnabled: true, offersChoices: true,
+                model: cloud)
                 == AIPreamble.text + "\n\n" + AIPreamble.choices + "\n\nAnswer only in haiku.",
             "instructions put the preamble and its choices before the trimmed user prompt")
         for prompt in [nil, "Answer only in haiku."] as [String?] {
             expect(
-                AIInstructions.compose(userPrompt: prompt, isEnabled: false, offersChoices: true)
+                AIInstructions.compose(
+                    userPrompt: prompt, isEnabled: false, offersChoices: true, model: cloud)
                     == nil,
                 "disabled instructions withhold the preamble, its choices and the user prompt")
+            expect(
+                AIInstructions.compose(
+                    userPrompt: prompt, isEnabled: true, offersChoices: true,
+                    model: .appleIntelligence)
+                    == nil,
+                "the on-device model gets no preamble, choices or user prompt")
         }
         expect(
             (AIPreamble.text + AIPreamble.choices).count < 1_800,
diff --git a/Tinycast/Features/AI/Model/AIInstructions.swift b/Tinycast/Features/AI/Model/AIInstructions.swift
index 41ed548b..6bf63e64 100644
--- a/Tinycast/Features/AI/Model/AIInstructions.swift
+++ b/Tinycast/Features/AI/Model/AIInstructions.swift
@@ -1,10 +1,12 @@
 import Foundation
 
-/// Every turn carries `AIPreamble` then the user's text; turned off, it carries neither.
+/// A turn carries `AIPreamble` then the user's text; off, or on device, it carries neither.
 enum AIInstructions {
     /// The user's own text goes last, so it can qualify the preamble rather than fight it.
-    static func compose(userPrompt: String?, isEnabled: Bool, offersChoices: Bool) -> String? {
-        guard isEnabled else { return nil }
+    static func compose(
+        userPrompt: String?, isEnabled: Bool, offersChoices: Bool, model: AIModelSelection?
+    ) -> String? {
+        guard isEnabled, model?.isOnDevice != true else { return nil }
         let trimmed = userPrompt?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
         return [AIPreamble.text, offersChoices ? AIPreamble.choices : "", trimmed]
             .filter { !$0.isEmpty }
