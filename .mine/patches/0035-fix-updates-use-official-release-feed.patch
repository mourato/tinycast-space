From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tinycast Recipe <recipe@localhost>
Date: Sat, 24 Oct 2026 15:34:52 -0300
Subject: [PATCH] fix(updates): use official release feed

---
 Tests/updates-test.swift                         | 16 ++++++++++++++++
 .../Features/Updates/Model/ReleaseFeed.swift     |  3 +--
 Tinycast/Windows/About/AboutView.swift           | 12 ++----------
 3 files changed, 19 insertions(+), 12 deletions(-)

diff --git a/Tests/updates-test.swift b/Tests/updates-test.swift
index fe9dfa41..0ce8ddd3 100644
--- a/Tests/updates-test.swift
+++ b/Tests/updates-test.swift
@@ -21,6 +21,7 @@ struct UpdatesTests {
         ordersVersions()
         roundTripsVersionsThroughJSON()
         derivesChannels()
+        usesOfficialRepository()
         picksNewestForChannel()
         picksTheZipThisMacCanRun()
         rejectsUnusableFeeds()
@@ -123,6 +124,21 @@ struct UpdatesTests {
 
     // MARK: - ReleaseFeed
 
+    static func usesOfficialRepository() {
+        expect(
+            ReleaseFeed.repository == "abue-ammar/tinycast",
+            "updates use the official Tinycast repository")
+
+        let release = AvailableRelease(
+            version: AppVersion("0.3.0")!, tag: "v0.3.0", notes: "",
+            assetURL: URL(string: "https://example.invalid/a.zip")!, assetSize: 1,
+            publishedAt: nil)
+        expect(
+            ReleaseFeed.page(for: release).absoluteString
+                == "https://github.com/abue-ammar/tinycast/releases/tag/v0.3.0",
+            "release links point to the official repository")
+    }
+
     /// Shaped like GitHub's `/releases` payload, down to the snake-cased keys.
     static func feed(_ entries: String...) -> Data {
         Data("[\(entries.joined(separator: ","))]".utf8)
diff --git a/Tinycast/Features/Updates/Model/ReleaseFeed.swift b/Tinycast/Features/Updates/Model/ReleaseFeed.swift
index 5d28d042..2e7f5669 100644
--- a/Tinycast/Features/Updates/Model/ReleaseFeed.swift
+++ b/Tinycast/Features/Updates/Model/ReleaseFeed.swift
@@ -12,8 +12,7 @@ struct AvailableRelease: Codable, Hashable, Sendable {
 /// Nothing throws: an unusable body means nothing to install, and the pump retries.
 enum ReleaseFeed {
     /// Where releases come from, and what every `@handle` and `#304` in their notes points at.
-    // tinycast-space: this build updates from the fork, never from upstream.
-    static let repository = "sermelipharo/tinycast-space"
+    static let repository = "abue-ammar/tinycast"
 
     /// The only artifact with an x86_64 slice, so the only one an Intel Mac can install.
     private static let universalMarker = "-Universal-"
diff --git a/Tinycast/Windows/About/AboutView.swift b/Tinycast/Windows/About/AboutView.swift
index 973df28c..3c50b734 100644
--- a/Tinycast/Windows/About/AboutView.swift
+++ b/Tinycast/Windows/About/AboutView.swift
@@ -56,14 +56,6 @@ struct AboutView: View {
             VStack(spacing: Theme.Spacing.sm) {
                 Text(Bundle.main.appDisplayName)
                     .font(.title.weight(.bold))
-                // tinycast-space: the edition chip, styled like the version chip in the accent colour.
-                Text("✨ Space Edition")
-                    .font(.caption.weight(.semibold))
-                    .foregroundStyle(Color.accentColor)
-                    .padding(.horizontal, Theme.Spacing.md)
-                    .padding(.vertical, Theme.Spacing.xs / 2)
-                    .background(Capsule().fill(Color.accentColor.opacity(0.12)))
-                    .overlay(Capsule().strokeBorder(Color.accentColor.opacity(0.35), lineWidth: 1))
                 Text(Self.version)
                     .font(.caption.monospacedDigit())
                     .foregroundStyle(.secondary)
@@ -157,8 +149,8 @@ private struct AboutLink: Identifiable {
             url: URL(string: "https://tinycast.dev/")!),
         AboutLink(
             id: "github", glyph: .brand("BrandGitHub"), title: "GitHub",
-            detail: "Tinycast Space Edition",
-            url: URL(string: "https://github.com/sermelipharo/tinycast-space")!),
+            detail: "github.com/abue-ammar/tinycast",
+            url: URL(string: "https://github.com/abue-ammar/tinycast")!),
         AboutLink(
             id: "discord", glyph: .brand("BrandDiscord"), title: "Discord",
             detail: String(localized: "Join the Tinycast community"),
-- 
2.56.0

