From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Abue Ammar <14371506+abue-ammar@users.noreply.github.com>
Date: Thu, 22 Oct 2026 07:07:55 +0600
Subject: [PATCH] Keep Volume Up/Down moving on devices that store a level off
 the grid (#1681)

---
 Tests/volume-test.swift                       | 22 ++++++++++++++++---
 .../SystemActions/Model/VolumeLevel.swift     |  9 ++------
 docs/features/launcher.md                     |  6 +++--
 3 files changed, 25 insertions(+), 12 deletions(-)

diff --git a/Tests/volume-test.swift b/Tests/volume-test.swift
index 206dff70..847448c2 100644
--- a/Tests/volume-test.swift
+++ b/Tests/volume-test.swift
@@ -42,9 +42,9 @@ struct VolumeLevelTests {
             }
         }
 
-        // Off-grid levels land on the nearest line in the direction of travel, never past it.
+        // Off-grid levels move one line from their nearest line.
         expect(VolumeLevel.stepped(0.37, up: true), 0.40, "up from 37% lands on 40%")
-        expect(VolumeLevel.stepped(0.37, up: false), 0.35, "down from 37% lands on 35%")
+        expect(VolumeLevel.stepped(0.37, up: false), 0.30, "down from 37% lands on 30%")
         expect(VolumeLevel.stepped(0.01, up: false), 0, "down from 1% lands on 0%")
         expect(VolumeLevel.stepped(0.99, up: true), 1, "up from 99% lands on 100%")
         expect(VolumeLevel.stepped(0.021, up: true), 0.05, "a hair above 2% still steps up to 5%")
@@ -56,11 +56,27 @@ struct VolumeLevelTests {
             expect(climbing, expected, "climbing from 37% reaches \(Int(expected * 100))%")
         }
         var falling = 0.37
-        for expected in [0.35, 0.30, 0.25, 0.20] {
+        for expected in [0.30, 0.25, 0.20, 0.15] {
             falling = VolumeLevel.stepped(falling, up: false)
             expect(falling, expected, "falling from 37% reaches \(Int(expected * 100))%")
         }
 
+        // A device that stores each level a hair off the line still walks the full range.
+        var storedHigh = 0.5
+        var target = storedHigh
+        for _ in 0..<10 {
+            target = VolumeLevel.stepped(storedHigh, up: false)
+            storedHigh = target + 0.01
+        }
+        expect(target, 0, "a device reading 1% high still steps from 50% down to 0%")
+        var storedLow = 0.5
+        target = storedLow
+        for _ in 0..<10 {
+            target = VolumeLevel.stepped(storedLow, up: true)
+            storedLow = target - 0.01
+        }
+        expect(target, 1, "a device reading 1% low still steps from 50% up to 100%")
+
         // The ends absorb further presses instead of wrapping or overshooting.
         expect(VolumeLevel.stepped(0, up: false), 0, "down at zero stays at zero")
         expect(VolumeLevel.stepped(1, up: true), 1, "up at full stays at full")
diff --git a/Tinycast/Features/SystemActions/Model/VolumeLevel.swift b/Tinycast/Features/SystemActions/Model/VolumeLevel.swift
index 29f0b87f..0d51c4a5 100644
--- a/Tinycast/Features/SystemActions/Model/VolumeLevel.swift
+++ b/Tinycast/Features/SystemActions/Model/VolumeLevel.swift
@@ -10,12 +10,9 @@ enum VolumeLevel {
         min(max(level, 0), 1)
     }
 
-    /// To the next grid line, not past it; a level already on the grid moves a full step.
+    /// From the nearest line, since a device may store a level slightly off the one it was given.
     static func stepped(_ level: Double, up: Bool) -> Double {
-        let exact = clamped(level) * Double(steps)
-        // The nudge absorbs binary error that would leave a downward step standing still.
-        let line =
-            up ? (exact + tolerance).rounded(.down) + 1 : (exact - tolerance).rounded(.up) - 1
+        let line = (clamped(level) * Double(steps)).rounded() + (up ? 1 : -1)
         return clamped(line / Double(steps))
     }
 
@@ -29,6 +26,4 @@ enum VolumeLevel {
         if muted || level == 0 { return "speaker.slash.fill" }
         return level < 0.5 ? "speaker.wave.1.fill" : "speaker.wave.2.fill"
     }
-
-    private static let tolerance = 1e-6
 }
diff --git a/docs/features/launcher.md b/docs/features/launcher.md
index b808bfac..d1f64619 100644
--- a/docs/features/launcher.md
+++ b/docs/features/launcher.md
@@ -537,8 +537,10 @@ Volume slider all render through `DialogController` rather than an `NSAlert`
 `arrow.clockwise`, Empty Trash `trash.slash` — so the dialog is recognizably about the row that
 opened it. Output volume and mute actions also show Tinycast's transient volume HUD, since macOS only draws
 its own for real media keys. Volume Up/Down walk a 5% grid (`VolumeLevel.stepped`, covered by
-`Tests/volume-test.swift`): an off-grid level snaps to the next line rather than past it, so from 37%
-up lands on 40% and down on 35%, and repeated presses stay on round numbers.
+`Tests/volume-test.swift`): each press moves one line from the level's nearest line, so from 37% up
+lands on 40% and down on 30%, and repeated presses stay on round numbers. Stepping from the nearest
+line matters for devices that store a level slightly off the one set (45.1% for 45%): stepping from
+the read-back level alone would aim at the same line again and never move.
 
 An action whose effect is invisible reports back through a pill (`MessageHUDController`, the same one
 Custom Commands and Snippets confirm through) rather than finishing silently:
