diff --git a/Tinycast/DesignSystem/Interaction/AnimatedPanel.swift b/Tinycast/DesignSystem/Interaction/AnimatedPanel.swift
new file mode 100644
index 00000000..0e27f122
--- /dev/null
+++ b/Tinycast/DesignSystem/Interaction/AnimatedPanel.swift
@@ -0,0 +1,11 @@
+import AppKit
+
+/// A panel that opens and closes with AppKit's document-window animation while Tinycast animates.
+@MainActor
+protocol AnimatedPanel: NSPanel {}
+
+extension AnimatedPanel {
+    func followMotion() {
+        animationBehavior = Motion.isEnabled ? .documentWindow : .none
+    }
+}
diff --git a/Tinycast/DesignSystem/Interaction/Motion.swift b/Tinycast/DesignSystem/Interaction/Motion.swift
new file mode 100644
index 00000000..28f3e96a
--- /dev/null
+++ b/Tinycast/DesignSystem/Interaction/Motion.swift
@@ -0,0 +1,24 @@
+import SwiftUI
+
+/// `AppCore` projects `AppSettings.animationsEnabled` here; global, so no surface can miss it.
+@MainActor
+enum Motion {
+    static var isEnabled = true
+
+    /// Zero while animations are off, so an AppKit animation group lands at once.
+    static func duration(_ duration: TimeInterval) -> TimeInterval {
+        isEnabled ? duration : 0
+    }
+}
+
+extension View {
+    /// Every hosting root applies this; the flag is read per transaction, so a toggle lands live.
+    func motionScope() -> some View {
+        transaction { transaction in
+            guard !Motion.isEnabled else { return }
+            transaction.animation = nil
+            // Without it, a descendant's `.animation(_:value:)` would insert its own again.
+            transaction.disablesAnimations = true
+        }
+    }
+}
