From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tinycast Recipe <recipe@localhost>
Date: Sat, 24 Oct 2026 12:45:32 -0300
Subject: [PATCH] tinycast-space 0015: alias tab
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Tab on an exact alias does what patch 0001's Space does: 0001's handler takes both keys, and sits after upstream's Tab handler so it is asked first. Any other Tab keeps upstream's paths (fields, quicklink arguments, the launcher → clipboard → AI cycle). Declined upstream (#1594); asked for in this fork's #16. Same caret rule as 0001.

Origin: tinycast-space 0015-alias-tab.patch @ ffccfc3
---
 Tinycast/Palette/RootPaletteView.swift | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/Tinycast/Palette/RootPaletteView.swift b/Tinycast/Palette/RootPaletteView.swift
index bc62f966..06e8f3f0 100644
--- a/Tinycast/Palette/RootPaletteView.swift
+++ b/Tinycast/Palette/RootPaletteView.swift
@@ -598,7 +598,7 @@ struct RootPaletteView: View {
                 return .handled
             }
             // tinycast-space: the alias jump. Later in the chain is asked first; see `aliasKeyPress`.
-            .onKeyPress(keys: [.space], phases: .down) { aliasKeyPress($0) }
+            .onKeyPress(keys: [.space, .tab], phases: .down) { aliasKeyPress($0) }
             .modifier(
                 ExtensionShortcutKeys(
                     screen: { menuOpen ? nil : screen as? ExtensionCommandScreen }, selection: sel)
@@ -1479,14 +1479,15 @@ struct RootPaletteView: View {
 
 }
 
-// tinycast-space: typing a user alias exactly and pressing Space opens its entry, the way Raycast
-// does. Kept out of the view, so upstream's code only carries the one line in `keyHandlers` that
-// calls in and the fallback in `focusPendingArgument`.
+// tinycast-space: typing a user alias exactly and pressing Space or Tab opens its entry, the way
+// Raycast does. Kept out of the view, so upstream's code only carries the one line in
+// `keyHandlers` that calls in and the fallback in `focusPendingArgument`.
 extension RootPaletteView {
     /// A row with inline arguments gets its first field focused; anything else runs, so further
     /// typing lands in the command's own search field. Apps and settings panes keep searching,
     /// since "tg something" is more often a query. Hooked after upstream's own key handlers: of
-    /// one view's `onKeyPress` handlers, the one later in the chain is asked first.
+    /// one view's `onKeyPress` handlers, the one later in the chain is asked first, so Tab on an
+    /// alias reaches this before the field order does.
     private func aliasKeyPress(_ press: KeyPress) -> KeyPress.Result {
         guard vm.mode == .launcher, searchFocused, argumentFocused == nil, !menuOpen,
             !vm.isComposing, !vm.isControlListOpen, !isCollapsed,
@@ -1494,7 +1495,7 @@ extension RootPaletteView {
             !vm.query.isEmpty, searchCaretAtEnd
         else { return .ignored }
         // "\ " escapes the Space: the backslash becomes a plain space and the query searches on.
-        if vm.query.hasSuffix("\\") {
+        if press.key == .space, vm.query.hasSuffix("\\") {
             vm.query.removeLast()
             vm.query += " "
             return .handled
-- 
