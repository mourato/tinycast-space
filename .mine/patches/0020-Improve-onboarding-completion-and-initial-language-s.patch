-            from: Self.allCases.map(\.rawValue), forPreferences: storedPreferences)
+            from: Self.allCases.map(\.rawValue), forPreferences: preferences)
         self = match.first.flatMap(Self.init(rawValue:)) ?? .english
     }
 }
