From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tinycast Recipe <recipe@localhost>
Date: Sat, 24 Oct 2026 12:45:33 -0300
Subject: [PATCH] tinycast-space 0021: app show info
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

⌘I on an application row, and *Show Info in Finder* under *Show in Finder* in its ⌘K menu, open Finder's Get Info through upstream's own `AppLauncher.showInfoInFinder` (the Uninstall screen's route, Apple events to Finder); a refused Automation permission shows upstream's notice. Meetings keep ⌘I (#1326, declined upstream).

Origin: tinycast-space 0021-app-show-info.patch @ ffccfc3
---
 .../Features/Launcher/UI/AppActionsMenu.swift   |  9 +++++++++
 .../Launcher/UI/LauncherCoordinator.swift       | 17 +++++++++++++++++
 .../Features/Launcher/UI/LauncherScreen.swift   | 10 ++++++++--
 3 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/Tinycast/Features/Launcher/UI/AppActionsMenu.swift b/Tinycast/Features/Launcher/UI/AppActionsMenu.swift
index dad71c2c..ed217f78 100644
--- a/Tinycast/Features/Launcher/UI/AppActionsMenu.swift
+++ b/Tinycast/Features/Launcher/UI/AppActionsMenu.swift
@@ -194,6 +194,15 @@ enum AppActionsMenu {
                     core.launcherCoordinator.showInFinder(app)
                 })
         }
+        if app.kind == .application {  // tinycast-space
+            items.append(
+                PopoverMenuItem(
+                    title: String(localized: "Show Info in Finder"), systemImage: "info.circle",
+                    shortcut: "⌘I"
+                ) {
+                    core.launcherCoordinator.showInfoInFinder(app)
+                })
+        }
         return items
     }
 }
diff --git a/Tinycast/Features/Launcher/UI/LauncherCoordinator.swift b/Tinycast/Features/Launcher/UI/LauncherCoordinator.swift
index cdc1cc6b..f3381160 100644
--- a/Tinycast/Features/Launcher/UI/LauncherCoordinator.swift
+++ b/Tinycast/Features/Launcher/UI/LauncherCoordinator.swift
@@ -291,6 +291,23 @@ final class LauncherCoordinator {
         AppLauncher.showInFinder(app.url)
     }
 
+    /// tinycast-space: Finder's Get Info for an app, as Raycast's ⌘I; the same route Uninstall takes.
+    func showInfoInFinder(_ app: AppEntry) {
+        guard app.kind == .application else { return }
+        paletteCoordinator.hidePalette(restoreFocus: false)
+        Task {
+            guard await !AppLauncher.showInfoInFinder(app.url) else { return }
+            await core.showNotice(
+                title: String(localized: "Couldn’t Open Get Info"),
+                message: String(
+                    localized: """
+                        Allow Tinycast to control Finder in System Settings › Privacy & Security \
+                        › Automation, then try again.
+                        """),
+                symbol: "info.circle", tone: .danger)
+        }
+    }
+
     /// Focus is never handed back: the relaunch takes it, or the app that refused has it.
     func restart(_ app: AppEntry) {
         guard app.kind == .application, let bundleID = app.bundleID else { return }
diff --git a/Tinycast/Features/Launcher/UI/LauncherScreen.swift b/Tinycast/Features/Launcher/UI/LauncherScreen.swift
index 15ee90a2..b7df3272 100644
--- a/Tinycast/Features/Launcher/UI/LauncherScreen.swift
+++ b/Tinycast/Features/Launcher/UI/LauncherScreen.swift
@@ -331,8 +331,14 @@ struct LauncherScreen: PaletteScreen {
         case .favoriteSlot(let index): return launchFavorite(at: index)
         case .copyCalculation: return copyCalculation(at: selection)
         case .openInApp, .showDetails:
-            guard let meeting = meeting(at: selection) else { return false }
-            return MeetingActionsMenu.perform(shortcut, meeting: meeting, core: core)
+            if let meeting = meeting(at: selection) {
+                return MeetingActionsMenu.perform(shortcut, meeting: meeting, core: core)
+            }
+            // tinycast-space: ⌘I on an app opens Finder's Get Info, as in Raycast.
+            guard shortcut == .showDetails, let app = entry(at: selection), app.kind == .application
+            else { return false }
+            core.launcherCoordinator.showInfoInFinder(app)
+            return true
         default: return false
         }
     }
-- 
