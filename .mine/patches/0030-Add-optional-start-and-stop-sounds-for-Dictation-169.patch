diff --git a/Tinycast/Features/Dictation/Service/DictationCueRunner.swift b/Tinycast/Features/Dictation/Service/DictationCueRunner.swift
new file mode 100644
index 00000000..fc43dead
--- /dev/null
+++ b/Tinycast/Features/Dictation/Service/DictationCueRunner.swift
@@ -0,0 +1,15 @@
+import AppKit
+
+@MainActor
+final class DictationCueRunner {
+    enum Cue { case start, stop }
+
+    private let startSound = NSSound(named: "DictationStart")
+    private let stopSound = NSSound(named: "DictationStop")
+
+    func play(_ cue: Cue) {
+        startSound?.stop()
+        stopSound?.stop()
+        (cue == .start ? startSound : stopSound)?.play()
+    }
+}
