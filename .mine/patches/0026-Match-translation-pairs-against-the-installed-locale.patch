From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Liu Zhen <lzhen.cn@outlook.com>
Date: Thu, 22 Oct 2026 09:39:34 +0800
Subject: [PATCH] Match translation pairs against the installed locale (#1665)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

* Match translation pairs against the installed locale

A pair is installed per locale, not per language: the bare `en`
NLLanguageRecognizer reports is `en-US`, so a Mac holding only
English (UK) reads `en -> zh` as not installed and the panel blamed
Chinese, which was installed.

Retry both sides across the framework's supported list, keeping the
script fixed, and name the side that is actually missing.

* Ask the exact translation pair before trying other spellings

An installed or unsupported pair is settled by its first query again, so English → English (UK) no longer walks 81 spelling pairs. Other spellings are tried only for a supported pair, both searches share one LanguageAvailability and supported list, and the helpers are private.

---------

Co-authored-by: abue-ammar <iabueammar@gmail.com>
---
 .../QuickActions/Service/TextTranslator.swift | 50 +++++++++++++++++--
 docs/features/quick-actions.md                | 10 ++++
 2 files changed, 57 insertions(+), 3 deletions(-)

diff --git a/Tinycast/Features/QuickActions/Service/TextTranslator.swift b/Tinycast/Features/QuickActions/Service/TextTranslator.swift
index 42a8021a..2f6d612f 100644
--- a/Tinycast/Features/QuickActions/Service/TextTranslator.swift
+++ b/Tinycast/Features/QuickActions/Service/TextTranslator.swift
@@ -38,16 +38,34 @@ enum TextTranslator {
     static func translate(_ text: String, to target: Locale.Language) async throws -> String {
         guard let source = sourceLanguage(of: text) else { throw Failure.undetectableSource }
         guard !source.isEquivalent(to: target) else { return text }
-        switch await LanguageAvailability().status(from: source, to: target) {
+        let availability = LanguageAvailability()
+        switch await availability.status(from: source, to: target) {
         case .installed:
-            break
+            return try await translate(text, from: source, to: target)
         case .supported:
-            throw Failure.notInstalled(language: displayName(of: target))
+            break
         case .unsupported:
             throw Failure.unsupported
         @unknown default:
             throw Failure.unsupported
         }
+        let supported = await availability.supportedLanguages
+        let sources = variants(of: source, among: supported)
+        let targets = variants(of: target, among: supported)
+        if let pair = await installedPair(sources, targets, availability) {
+            return try await translate(text, from: pair.source, to: pair.target)
+        }
+        // Every source spelling already failed, so only a third language can prove the target.
+        let partners = supported.filter {
+            $0.languageCode != source.languageCode && $0.languageCode != target.languageCode
+        }
+        let targetIsInstalled = await installedPair(partners, targets, availability) != nil
+        throw Failure.notInstalled(language: displayName(of: targetIsInstalled ? source : target))
+    }
+
+    private static func translate(
+        _ text: String, from source: Locale.Language, to target: Locale.Language
+    ) async throws -> String {
         do {
             let session = TranslationSession(installedSource: source, target: target)
             return try await session.translate(text).targetText
@@ -56,6 +74,32 @@ enum TextTranslator {
         }
     }
 
+    /// A download is a locale, so the region a bare code resolves to can miss the one installed.
+    private static func installedPair(
+        _ sources: [Locale.Language], _ targets: [Locale.Language],
+        _ availability: LanguageAvailability
+    ) async -> (source: Locale.Language, target: Locale.Language)? {
+        for source in sources {
+            for target in targets {
+                if await availability.status(from: source, to: target) == .installed {
+                    return (source, target)
+                }
+            }
+        }
+        return nil
+    }
+
+    /// Region may move, since one English is another's asset, but a different script is a language.
+    private static func variants(
+        of language: Locale.Language, among supported: [Locale.Language]
+    ) -> [Locale.Language] {
+        [language]
+            + supported.filter {
+                $0.languageCode == language.languageCode && $0.script == language.script
+                    && !$0.isEquivalent(to: language)
+            }
+    }
+
     /// Minimal, not maximal: the maximal form would spell `es` "Spanish (Latin, Spain)" in a menu.
     static func displayName(of language: Locale.Language) -> String {
         Locale.current.localizedString(forIdentifier: language.minimalIdentifier)
diff --git a/docs/features/quick-actions.md b/docs/features/quick-actions.md
index e4c4b92a..6e7bc1ea 100644
--- a/docs/features/quick-actions.md
+++ b/docs/features/quick-actions.md
@@ -151,6 +151,12 @@ nothing on every route, and a 3B model is markedly worse at it. `NLLanguageRecog
 source language, because `TranslationSession(installedSource:target:)` needs a concrete one and
 `LanguageAvailability` reports only a status.
 
+**A download is a locale, not a language.** Apple matches `en-US` and `en-GB` separately, so the bare
+`en` the recognizer reports finds only the first and calls an installed `en-GB` pair missing — which
+read as *Chinese hasn't been downloaded yet* on a Mac that had Chinese. Both sides are retried across
+every supported spelling of the same script before the panel names a language, and the language it
+names is the one with no downloaded asset of its own.
+
 `TranslationError` is annotated `macOS 26.4` while the deployment floor is `26.0`, so failures are
 caught as plain `Error` and reported by what was asked rather than by matching its cases.
 
@@ -298,6 +304,10 @@ failure handler, so automatic expansion stays silent as before.
   `quickActionModelOverrides`.
 - Translate into a language that has not been downloaded: the panel names the language, and its
   button closes the panel and opens Language & Region.
+- Download English (UK) alone, with English (US) absent, and translate English text: the panel must
+  translate rather than call the target language missing.
+- Translate Korean text with Korean not downloaded and the target language installed: the panel names
+  Korean, the language that is actually missing.
 - Revoke Accessibility while enabled: a HUD explains instead of failing silently.
 - Harnesses: `quick-action-test` (action metadata, prompt boundaries, preview choices, routes and
   their repair) and
